+    let before=list;
+    if options().1 {
+        if policy::remove(&mut list){
+            if rd::<[u8;policy::SLOTS]>(save+0x44)==before{
+                std::ptr::copy_nonoverlapping(list.as_ptr(),(save+0x44) as *mut u8,policy::SLOTS);
+                log("Dual Wield removed for uninstall; every other ability/state retained");
+            }
+        }
+        set_on(false);super::leftblade::hide();return;
+    }
+    let valid=loaded&&rd::<u8>(save+4)>0&&rd::<u8>(save+5)>0&&rd::<u8>(save+6)>0;
+    let weapon=super::equip::sora_weapon(base).unwrap_or(0);
+    let instance=if loaded{super::pose::ptr(rd::<u32>(sora+0x15c))}else{0};
+    let world=if readable(instance,0x200){rd::<u32>(instance+0x1b4)}else{0};
+    let binding=(sora,instance,world,weapon);
+    if let Ok(mut b)=BINDING.try_lock(){
