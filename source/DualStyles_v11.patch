+pub fn glide_blades(points:&[[f32;3]],right:glam::Mat4,left:glam::Mat4,radius:f32)
+    ->Option<[Vec<combat_core::Shape>;2]>{
+    if !(2..=32).contains(&points.len()) || !radius.is_finite() || !(1.0..=80.0).contains(&radius)
+        || !right.is_finite() || !left.is_finite() || right.determinant().abs()<1e-6
+        || left.determinant().abs()<1e-6 || !points.iter().flatten().all(|v|v.is_finite()) {return None;}
+    let turn=left*right.inverse();
+    let shape=|p:glam::Vec3|combat_core::Shape::sphere([p.x,-p.y,p.z],radius);
+    let (start,end)=(glam::Vec3::from(points[0]),glam::Vec3::from(*points.last()?));
+    let length=start.distance(end);
+    if !length.is_finite() || length<=0.0{return None;}
+    // Fill the native straight blade range, including both ends, within the contact
+    // engine's 32 swept-shape limit. Reject a range too long for complete coverage.
+    if length>radius*2.0*31.0{return None;}
+    let n=((length/(radius*1.5)).ceil() as usize+1).clamp(2,32);
