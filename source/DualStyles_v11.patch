index 0000000..ad41989
--- /dev/null
+++ b/crates/kh1-hook/src/win/dual_hover.rs
@@ -0,0 +1,67 @@
+//! A floor clamp on KH1's existing regular Glide, only in Dual Ranged.
+//! Native input, horizontal movement, collision, damage interruption and ability gates remain.
+use super::{addr::Rva,dual,hook,pose,takeover};
+use std::sync::atomic::{AtomicBool,AtomicUsize,Ordering};
+
+const MOVE:Rva=Rva(0x2B0890);
+const INPUT:Rva=Rva(0x2B0A60);
+const MOVE_HEAD:[u8;10]=[0x48,0x89,0x5c,0x24,0x08,0x48,0x89,0x74,0x24,0x10];
+const INPUT_HEAD:[u8;10]=MOVE_HEAD;
+static ORIG_MOVE:AtomicUsize=AtomicUsize::new(0);
+static ORIG_INPUT:AtomicUsize=AtomicUsize::new(0);
+static READY:AtomicBool=AtomicBool::new(false);
+
+fn readable(p:usize,n:usize)->bool{
+    p>=0x10000 && p.checked_add(n.saturating_sub(1)).is_some_and(|e|
+        unsafe{super::crash::readable(p)&&super::crash::readable(e)})
+}
+unsafe fn rd<T:Copy>(p:usize)->T{std::ptr::read_unaligned(p as *const T)}
+unsafe fn wr<T:Copy>(p:usize,v:T){std::ptr::write_unaligned(p as *mut T,v)}
+unsafe fn work(actor:usize)->Option<usize>{
+    if !READY.load(Ordering::Acquire) || !dual::ranged() || dual::owned()
+        || !readable(actor,0x4b0) || actor!=takeover::sora_actor()
+        || rd::<i32>(actor+0x70)!=21 || rd::<u32>(actor)&0x0100_0004!=0
+        || pose::ptr(rd::<u32>(actor+0x440))!=0 || rd::<u32>(actor+0x444)&1!=0{return None;}
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    if rd::<u32>(base+Rva(0x298D3A0))!=0{return None;}
+    let work=pose::ptr(rd::<u32>(actor+0x148));
+    (readable(work,0x108) && rd::<u32>(work+0x104)&1==0).then_some(work)
+}
+
+unsafe extern "system" fn movement(actor:usize,out:usize)->f32{
+    let f:unsafe extern "system" fn(usize,usize)->f32=std::mem::transmute(ORIG_MOVE.load(Ordering::Acquire));
+    let result=f(actor,out);
+    if work(actor).is_none() || !readable(out,16){return result;}
+    if let Some(down)=crate::dual_wield::glide_descent(dual::style(),false,
+        rd::<f32>(actor+0x3d4),rd::<f32>(out+4)){
+        wr(out+4,down);wr(actor+0x3c4,down);
+    }
+    result
+}
+unsafe extern "system" fn input(actor:usize,pad:usize,dir:usize){
+    let f:unsafe extern "system" fn(usize,usize,usize)=std::mem::transmute(ORIG_INPUT.load(Ordering::Acquire));
+    if let Some(work)=work(actor).filter(|_|readable(pad,8)){
+        // Regular Glide reads held bit 4 from this native input record. Its initial
+        // grace timer normally postpones release; let an actual release end it now.
+        if rd::<u32>(pad+4)&4==0 {wr(work+0x100,0.0f32);}
+    }
+    f(actor,pad,dir);
+}
+pub unsafe fn install()->bool{
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    // Check subtype, height and input operands too, before either hook is installed.
+    // These are whole position-independent operands in both supported compilations.
+    for (at,expect) in [(base+MOVE+0x3f,&[0xf6,0x80,0x04,0x01,0x00,0x00,0x01][..]),
+        (base+MOVE+0x48,&[0xf3,0x0f,0x10,0x83,0xd4,0x03,0x00,0x00][..]),
+        (base+INPUT+0x9b,&[0xf6,0x80,0x04,0x01,0x00,0x00,0x01][..]),
+        (base+INPUT+0xaf,&[0x85,0x46,0x04][..])]{
+        if !readable(at,expect.len()) || std::slice::from_raw_parts(at as *const u8,expect.len())!=expect{
+            super::log("DUAL RANGED GLIDE HOVER DISABLED: native subtype/height/input operands do not match");return false;
+        }
+    }
+    let a=hook::install(base+MOVE,&MOVE_HEAD,movement as *const () as usize,&ORIG_MOVE,"Dual Ranged Glide floor clamp").is_some();
+    let b=hook::install(base+INPUT,&INPUT_HEAD,input as *const () as usize,&ORIG_INPUT,"Dual Ranged Glide release").is_some();
+    READY.store(a&&b,Ordering::Release);
+    if a&&b{super::log("DUAL RANGED GLIDE HOVER READY: established regular Glide descends to one native unit above the floor, then stays level; release ends Glide; no ground start or Superglide change");}
+    a&&b
+}
