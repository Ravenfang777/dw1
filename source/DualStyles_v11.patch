+pub fn can_request(state: i32, slot: Option<usize>, owned: bool) -> bool {
+    if owned { return matches!(state, 0..=2) && matches!(slot, Some(0..=13)); }
+    match state {
+        0 => matches!(slot, Some(0..=7)),
+        1 | 2 => matches!(slot, Some(8..=13)),
+        _ => false,
+    }
+}
+
+pub fn idle_slot(state: i32, slot: Option<usize>) -> bool {
+    state == 0 && matches!(slot, Some(0 | 1))
+}
