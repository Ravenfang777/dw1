+/// A cosmetic hold calibrated while the primary is actually held. Native casting/stowing
+/// can collapse or move its weapon subtree; that subtree must not reposition the offhand.
+#[derive(Clone)]
+pub struct NativeAttachment { local:[glam::Mat4;13], binding:Binding }
+
+impl NativeAttachment {
+    pub fn capture(pose:&WeaponPose,hand:glam::Mat4)->Option<Self>{
+        if !hand.is_finite() || hand.determinant().abs()<1e-6
+            || pose.bones[0].determinant().abs()<1e-6{return None;}
+        let inverse=hand.inverse();
+        let local=pose.bones.map(|m|inverse*m);
+        local.iter().all(|m|m.is_finite()).then_some(Self{local,binding:pose.binding})
+    }
+    pub fn pose(&self,hand:glam::Mat4,binding:Binding,frame:u64)->Option<WeaponPose>{
+        if self.binding!=binding || !hand.is_finite() || hand.determinant().abs()<1e-6{return None;}
+        WeaponPose::new(self.local,hand,glam::Mat4::IDENTITY,binding,frame)
+    }
+    pub fn binding(&self)->Binding{self.binding}
+}
