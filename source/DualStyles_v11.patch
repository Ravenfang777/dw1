--- /dev/null
+++ b/crates/kh1-hook/src/win/dual_cast.rs
@@ -0,0 +1,87 @@
+//! Visual-only Master casts over native KH1 spells. No spell/controller/event writes.
+use super::{log, pose};
+use crate::dual_wield::{self as policy, CastFrame, NativeCast, NativeMotion};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+struct Cast { clock:NativeCast, reported:bool }
+static CAST:Mutex<Option<Cast>>=Mutex::new(None);
+static LOGGED:AtomicU32=AtomicU32::new(0);
+
+fn readable(p:usize,n:usize)->bool {
+    p>=0x10000 && p.checked_add(n.saturating_sub(1)).is_some_and(|e|
+        unsafe{super::crash::readable(p)&&super::crash::readable(e)})
+}
+unsafe fn rd<T:Copy>(p:usize)->T { std::ptr::read_unaligned(p as *const T) }
+
+pub fn clear(){if let Ok(mut c)=CAST.try_lock(){*c=None;}}
+
+pub unsafe fn snapshot(actor:usize)->Option<NativeMotion>{
+    if !readable(actor,0x180){return None;}
+    Some(NativeMotion{id:(rd::<u32>(actor+0x164)&0xffff) as u16,
+        clock:rd::<f32>(actor+0x16c),
+        queued:(rd::<u32>(actor+0x178)!=0).then(||(rd::<u32>(actor+0x17c)&0xffff) as u16)})
+}
+
+/// Called after the original native command step, and only for an existing KH1 spell.
+pub unsafe fn observed(actor:usize,spell:u8,before:NativeMotion){
+    if !super::dual::enabled() || !pose::kh2().is_some_and(|k|k.master.is_some()){return;}
+    let Some(binding)=super::dual::binding().filter(|b|b.actor==actor) else{return;};
+    let Some(after)=snapshot(actor) else{return;};
+    let Some(motion)=policy::started_motion(before,after).filter(|id|*id>=0x20) else{return;};
+    let air=matches!(rd::<i32>(actor+0x70),1|2);
+    let level=super::reflect::kh1_spell_level(spell);
+    let frame=super::takeover::GAME_FRAME.load(Ordering::Relaxed);
+    let Some(clock)=NativeCast::new(binding,spell,level,air,motion,frame) else{return;};
+    if let Ok(mut c)=CAST.try_lock(){*c=Some(Cast{clock,reported:false});}
+}
+
+pub struct Sample {pub motion:u16,pub frame:f32}
+
+/// Read-only sample from the exact native cast motion. A failed, interrupted or stale
+/// request falls through to KH1; the donor never runs spells, damage, root travel or FX.
+pub unsafe fn sample(actor:usize,instance:usize)->Option<Sample>{
+    if !super::dual::enabled() || super::dual::owned(){clear();return None;}
+    let binding=super::dual::binding()?;
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    if binding.actor!=actor || binding.instance!=instance
+        || !matches!(rd::<i32>(actor+0x70),0..=2)
+        || rd::<u32>(base+super::addr::Rva(0x298D3A0))!=0
+        || pose::ptr(rd::<u32>(actor+0x440))!=0 || rd::<u32>(actor+0x444)&1!=0 {
+        clear();return None;
+    }
+    let mut state=CAST.try_lock().ok()?;
+    let cast=state.as_mut()?;
+    let kh2=pose::kh2()?; let master=kh2.master.as_ref()?;
+    let donor=policy::spell_donor(cast.clock.spell)?;
+    let magc=kh2.battle.magc.iter().find(|r|r.id==donor&&r.level==cast.clock.level&&r.world==0);
+    let air=cast.clock.air;
+    let fallback=match(donor,air){(0,false)=>56,(0,true)=>58,(1,false)=>59,(1,true)=>61,
+        (2,false)=>62,(2,true)=>64,(3,false)=>65,(3,true)=>67,_=>return None};
+    let motion=magc.and_then(|r|{let m=if air{r.air_motion}else{r.ground_motion};
+        (m>=0).then_some(m as u16)}).unwrap_or(fallback);
+    let Some(donor_clip)=master.rig.motions.get(&motion) else{*state=None;return None;};
+    let pointer=rd::<u64>(instance+8) as usize;
+    if !readable(pointer,0x34){*state=None;return None;}
+    let length=rd::<u32>(pointer+4) as f32;
+    let native=snapshot(actor)?;
+    let frame=super::takeover::GAME_FRAME.load(Ordering::Relaxed);
+    // The actor may publish its id before the model pass applies that motion. Never
+    // latch the old idle/run/jump header as the new cast's duration or motion identity.
+    if !matches!(pose::sora_slot(),Some(14..=97)) {
+        if !cast.reported && frame.saturating_sub(cast.clock.requested_at)<=6{return None;}
+        *state=None;return None;
+    }
+    match cast.clock.sample(binding,frame,native,pointer,length,kh2_anim::length_frames(donor_clip)){
+        CastFrame::Waiting=>None,
+        CastFrame::Ended=>{*state=None;None},
+        CastFrame::Playing(at)=>{
+            if !cast.reported && LOGGED.fetch_add(1,Ordering::Relaxed)<100 {
+                cast.reported=true;
+                log(&format!("DUAL WIELD MASTER CAST: KH1 spell {} level {} air={} native_motion={:#x} native_frames={} donor_motion={} donor_frames={:.1}; native spell logic/events/MP/movement retained; visual clock follows native frame",
+                    cast.clock.spell,cast.clock.level,air,cast.clock.motion,length,motion,kh2_anim::length_frames(donor_clip)));
+            }
+            Some(Sample{motion,frame:at})
+        }
+    }
+}
