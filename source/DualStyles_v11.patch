+/// The same native frame can draw Sora repeatedly. Advance from one shared game-time
+/// snapshot, not per draw or from the native idle clip (which may wrap or hold its end).
+#[derive(Default,Debug)]
+pub struct LoopClock { last:Option<(Visual,f64)>, phase:f64 }
+impl LoopClock {
+    pub fn reset(&mut self){self.last=None;self.phase=0.0;}
+    pub fn sample(&mut self,visual:Visual,time:f64,length:f32,speed:f32)->Option<f32>{
+        if !visual.continuous() || !time.is_finite() || time<0.0 || !length.is_finite()
+            || length<=0.0 || !speed.is_finite() || speed<=0.0 {self.reset();return None;}
+        // Combat and cutscene idles share exactly the same clip and clock.
+        let family=if visual.idle(){Visual::Idle}else{visual};
+        match self.last {
+            Some((old,at)) if old==family && time>=at && time-at<=5.0 => {
+                self.phase=(self.phase+(time-at)*speed as f64).rem_euclid(length as f64);
+            }
+            _=>self.phase=0.0,
+        }
+        self.last=Some((family,time));
+        // Conversion to f32 must not round the final fraction up to the end frame.
+        let frame=self.phase as f32;
+        Some(if frame<length{frame}else{0.0})
+    }
 }
 
