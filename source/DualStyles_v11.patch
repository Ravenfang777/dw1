diff --git a/crates/kh1-hook/src/win/dualglide.rs b/crates/kh1-hook/src/win/dualglide.rs
new file mode 100644
index 0000000..ff6ee92
--- /dev/null
+++ b/crates/kh1-hook/src/win/dualglide.rs
@@ -0,0 +1,78 @@
+//! Final's glide weapon windows while native KH1 Glide/Superglide owns movement.
+use super::{addr::Rva,combat,dual,log,pose,takeover};
+use crate::dual_wield::{Binding,GlidePose};
+use glam::Mat4;
+use std::sync::{Mutex,atomic::Ordering};
+
+static POSE:Mutex<Option<GlidePose>>=Mutex::new(None);
+static STATE:Mutex<Option<Glide>>=Mutex::new(None);
+struct Glide {
+    binding:Binding,
+    frame:u64,
+    anim:kh2_rig::RigAnim,
+    character:character_core::Character,
+    hits:kh2_rig::MotionHits,
+    strikes:combat::Strikes,
+}
+
+pub fn discard_pose(){if let Ok(mut p)=POSE.try_lock(){*p=None;}}
+pub fn clear(){discard_pose();if let Ok(mut s)=STATE.try_lock(){*s=None;}}
+fn gap(binding:Binding,frame:u64,step:f32){
+    if let Ok(mut state)=STATE.try_lock(){
+        if let Some(s)=state.as_mut().filter(|s|s.binding==binding && s.frame!=frame){
+            s.frame=frame;s.strikes.glide_gap(step);
+        }
+    }
+}
+
+/// A completed displayed body and two-weapon pose only. Capture geometry here; all
+/// attack construction and native contacts run later on the native physics callback.
+pub unsafe fn capture(actor:usize,donor_frame:f32,right:Mat4,left:Mat4){
+    let Some(binding)=dual::binding().filter(|b|b.actor==actor) else{return;};
+    let Some(blades)=combat::glide_blades(actor,right,left) else{return;};
+    let sample=GlidePose{binding,frame:takeover::GAME_FRAME.load(Ordering::Relaxed),
+        donor_frame,actor:std::ptr::read_unaligned((actor+0x10) as *const [f32;3]),blades};
+    if sample.current_blades(binding,sample.frame,sample.actor).is_none(){return;}
+    if let Ok(mut p)=POSE.try_lock(){*p=Some(sample);}
+}
+
+/// Called once AFTER native Sora physics, with its actual state/position. Native movement,
+/// action selection, input, spells and abilities are never stepped by this helper.
+pub unsafe fn step(actor:usize){
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    let eligible=dual::visual(actor,pose::sora_slot(),pose::SORA_INSTANCE.load(Ordering::Relaxed))
+        .is_some_and(|v|v.glide());
+    if !eligible {clear();return;}
+    let step=crate::dual_wield::animation_step(std::ptr::read_unaligned((base+Rva(0x23405DC)) as *const f32)) as f32;
+    if step==0.0{return;}
+    let Some(binding)=dual::binding() else{clear();return;};
+    let frame=takeover::GAME_FRAME.load(Ordering::Relaxed);
+    let sample=POSE.try_lock().ok().and_then(|mut p|p.take());
+    let at=std::ptr::read_unaligned((actor+0x10) as *const [f32;3]);
+    let Some((sample,blades))=sample.and_then(|p|p.current_blades(binding,frame,at).map(|b|(p,b)))
+        else{gap(binding,frame,step);return;};
+    let Some(form)=pose::kh2().and_then(|k|k.final_form.as_ref()) else{clear();return;};
+    let Some(clip)=form.character.moveset.clips.get(&character_core::motion::GLIDE) else{clear();return;};
+    let Ok(mut state)=STATE.try_lock() else{return;};
+    if state.as_ref().is_none_or(|s|s.binding!=binding || frame<s.frame || frame-s.frame>1){
+        let mut character=form.character.clone();
+        character.abilities=crate::dual_wield::abilities(&[]);
+        character.carry_into_air([0.0;2],0.0); // Select native aerial contact rows only.
+        *state=Some(Glide{binding,frame:frame.wrapping_sub(1),
+            anim:kh2_rig::RigAnim::new(form.rig.clone()),character,
+            hits:kh2_rig::MotionHits::default(),strikes:combat::Strikes::default()});
+        log("DUAL WIELD GLIDE CONTACT READY: Final weapon windows; displayed equipped-blade length; native hurtparts/contact feedback; per-blade donor re-hit interval; KH1 movement retained");
+    }
+    let s=state.as_mut().unwrap();
+    if s.frame==frame{return;}
+    s.frame=frame;
+    let hitboxes=s.hits.step_at(Some(clip),sample.donor_frame).into_iter()
+        .filter(crate::dual_wield::glide_hit).collect();
+    let out=character_core::Output{displacement:[0.0;3],facing:0.0,
+        state:character_core::StateName::Glide,motion:character_core::motion::GLIDE,
+        clip_frame:sample.donor_frame as u32,hitboxes,invulnerable:false,guarding:false,
+        guard_boxes:Vec::new(),weapon_trail:false,locked:None,combo_count:0,
+        combo_live:false,events:Vec::new()};
+    s.strikes.look(actor);
+    s.strikes.glide_strike(actor,&out,&s.anim,&mut s.character,&form.battle,&blades,step);
+}
