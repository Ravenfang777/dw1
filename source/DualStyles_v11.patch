+/// KH1's takeoff/rise pairs (8/9, 12/13) divide one Valor jump. Use each native clip's
+/// duration, including its own rate, so changing to the rise cannot restart the donor.
+pub fn visual_sample(visual:Visual,slot:usize,clock:f32,current:NativeClip,
+    jump:Option<(NativeClip,NativeClip)>,donor_length:f32)->Option<f32>{
+    current.seconds()?;
+    if !clock.is_finite() || clock<0.0 {return None;}
+    if visual!=Visual::Jump {return visual_frame(clock,current.frames,donor_length,visual.looping());}
+    let (start,rise)=jump?;
+    let (a,b)=(start.seconds()?,rise.seconds()?);
+    let first=match slot {8|12=>true,9|13=>false,_=>return None};
+    let expected=if first{start}else{rise};
+    if (expected.frames-current.frames).abs()>0.01 || (expected.fps-current.fps).abs()>0.01{return None;}
+    let elapsed=if first{0.0}else{a}+clock.min(current.frames)/current.fps;
+    visual_frame(elapsed,a+b,donor_length,false)
+}
