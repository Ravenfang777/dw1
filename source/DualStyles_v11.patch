+/// Match an imported visual to the live native animation's phase. Native casting's clock
+/// never loops: a completed cast cannot restart its donor animation at zero.
+pub fn visual_frame(native:f32, native_length:f32, donor_length:f32, looping:bool)->Option<f32>{
+    if !native.is_finite() || native<0.0 || !native_length.is_finite() || native_length<=0.0
+        || !donor_length.is_finite() || donor_length<=0.0 { return None; }
+    let phase=native/native_length;
+    Some(if looping { phase.fract()*donor_length } else { phase.clamp(0.0,1.0)*donor_length })
