+/// KH1's native time step uses 60-Hz units and caps at five. Invalid reads must never
+/// become a wall-clock catch-up or feed NaNs into the pose evaluator.
+pub fn animation_step(step:f32)->f64{
+    if step.is_finite() && (0.0..=5.0).contains(&step){step as f64}else{0.0}
