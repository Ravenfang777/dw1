+pub const GUARD_ROW:u8=11;
+/// Valor's action-button row is a rising attack. Admit only that explicit, ability-free
+/// row with real weapon hit windows and no guard window, never a guessed motion number.
+pub fn valor_guard(moveset:&character_core::Moveset)->Option<&ComboRow>{
+    use character_core::WindowKind;
+    moveset.combo_rows.iter().find(|r|r.id==GUARD_ROW && r.kind==0 && r.ability==0
+        && !r.is_air() && r.jump.is_finite() && r.is_jump()).filter(|r|{
+        moveset.clips.get(&r.motion).is_some_and(|c|
+            c.windows.iter().any(|w|matches!(w.kind,WindowKind::Hitbox{weapon:1|2,..}))
+            && !c.windows.iter().any(|w|matches!(w.kind,WindowKind::Guard{..})))
+    })
+}
+
+pub fn retain_passive(moveset:&mut character_core::Moveset)->bool{
+    let guard=valor_guard(moveset).cloned();
+    // Fix references while the explicit hop is absent: ordinary Attack cannot select it
+    // through an anti-repeat sub row. Row kind 0 is reached only by the action button.
+    retain_base(&mut moveset.combo_rows);
+    moveset.combo_rows.retain(|r|r.id!=GUARD_ROW);
+    fix_subs(&mut moveset.combo_rows);
+    if let Some(mut guard)=guard {guard.sub=-1;moveset.combo_rows.push(guard);true}else{false}
+}
+
+/// Mirror native ground Guard versus Dodge Roll selection. The native command word is
+/// already a fresh action, and a chosen menu command/jump has priority. KH1's abilities
+/// supply 0x10 Guard and 0x20 Dodge Roll; threshold is its own stats +8, tilt dir +0xC.
+pub fn guard_selected(command:u32,flags:u32,state:i32,threshold:f32,tilt:f32)->bool{
+    command&0x0400_0000!=0 && command&0x0100_00FF==0 && flags&0x10!=0 && state==0
+        && threshold.is_finite() && tilt.is_finite() && threshold>=0.0 && tilt>=0.0
+        && (flags&0x20==0 || threshold>tilt)
+}
+
+/// Only a proven selected native Guard may bypass the ordinary combo-lane admission.
+pub fn guard_ownership(state:i32,slot:Option<usize>)->bool{state==0 && slot.is_some()}
+/// The new ability-free donor row must not turn raw Square into an unearned action during
+/// an unrelated imported combo. Entry comes only from the proven native Guard selection.
+pub fn guard_input(raw:bool,shortcut:bool,session:bool)->bool{raw && !shortcut && session}
+
 fn fix_subs(rows: &mut [ComboRow]) {
     let ids: Vec<_> = rows.iter().map(|r| r.id).collect();
     for r in rows {
