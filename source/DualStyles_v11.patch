+/// Scene body overlays retain native local motion on unretargeted children (including the
+/// face). Read from native local matrices, never the world pose we may already have drawn.
+pub fn native_children(out:&mut [glam::Mat4],locals:&[glam::Mat4],parents:&[i16],mapped:&[bool])->bool{
+    let n=out.len();
+    if locals.len()<n || parents.len()<n || mapped.len()<n{return false;}
+    let mut next=out.to_vec();
+    for i in 0..n {
+        if mapped[i]{continue;}
+        let p=parents[i];
+        if p>=i as i16 || !locals[i].is_finite(){return false;}
+        next[i]=if p<0{locals[i]}else{next[p as usize]*locals[i]};
+    }
+    if !next.iter().all(|m|m.is_finite()){return false;}
+    out.copy_from_slice(&next);true
+}
