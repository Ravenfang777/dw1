+}
+
+/// Called on the game thread. Only our own ability entry may be written.
+pub unsafe fn frame(){
+    if !READY.load(Ordering::Relaxed){return;}
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    ensure_table(base);
+    let sora=super::takeover::sora_actor();
+    let loaded=readable(sora,0x4b0)&&(rd::<u32>(sora+0x374)&3)==1;
+    let Some(save)=super::menu::save_block(base).filter(|s|readable(*s,0x74)) else {set_on(false);return;};
