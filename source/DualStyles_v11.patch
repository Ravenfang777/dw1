+}
+impl GlidePose {
+    /// The next native physics step may translate the last drawn pose by Sora's actual
+    /// movement. Never carry it across a missed draw, a teleport, rebind or future frame.
+    pub fn current_blades(&self,binding:Binding,frame:u64,actor:[f32;3])
+        ->Option<[Vec<combat_core::Shape>;2]>{
+        if self.binding!=binding || frame<self.frame || frame-self.frame>1
+            || !self.donor_frame.is_finite() || self.donor_frame<0.0
+            || !self.actor.iter().chain(actor.iter()).all(|v|v.is_finite()){return None;}
+        let delta=glam::Vec3::from(actor)-glam::Vec3::from(self.actor);
+        if delta.length()>120.0{return None;}
+        let mut blades=self.blades.clone();
+        for blade in &mut blades {
+            if blade.len()<2 || blade.len()>32{return None;}
+            for s in blade {
+                if !s.center.iter().all(|v|v.is_finite()) || !s.radius.is_finite()
+                    || !(1.0..=80.0).contains(&s.radius){return None;}
+                if (glam::Vec3::new(s.center[0],-s.center[1],s.center[2])
+                    -glam::Vec3::from(self.actor)).length()>800.0{return None;}
+                s.center[0]+=delta.x;s.center[1]-=delta.y;s.center[2]+=delta.z;
+            }
+        }
+        Some(blades)
+    }
+}
