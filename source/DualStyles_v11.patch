+//! Passive Dual Wield: one ability, duplicate held weapon, ground attacks only.
+use super::{addr::Rva, log};
+use crate::dual_wield as policy;
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicUsize, Ordering};
+use std::sync::OnceLock;
+use std::sync::Mutex;
+
+const TABLE_PTR: Rva=Rva(0x2D37748);
+const TO_HANDLE: Rva=Rva(0x38B080);
+const LOAD: Rva=Rva(0x28D840);
+const LOAD_PROLOGUE:[u8;9]=[0x40,0x53,0x57,0x41,0x56,0x48,0x83,0xEC,0x20];
+static TABLE:OnceLock<usize>=OnceLock::new();
+static NAMES:OnceLock<(u32,u32)>=OnceLock::new();
+static ORIG_LOAD:AtomicUsize=AtomicUsize::new(0);
+static ON:AtomicBool=AtomicBool::new(false);
+static OWNED:AtomicBool=AtomicBool::new(false);
+static REQUEST:AtomicBool=AtomicBool::new(false);
+static FRAMES:AtomicU32=AtomicU32::new(0);
+static CONFIG:OnceLock<(bool,bool)>=OnceLock::new();
+static READY:AtomicBool=AtomicBool::new(false);
+static REPORTED_READY:AtomicBool=AtomicBool::new(false);
+static BINDING:Mutex<Option<(usize,usize,u32,u8)>>=Mutex::new(None);
+
+unsafe fn rd<T:Copy>(p:usize)->T{std::ptr::read_unaligned(p as *const T)}
+fn readable(p:usize,n:usize)->bool {p>=0x10000&&p.checked_add(n.saturating_sub(1)).is_some_and(|e|unsafe{super::crash::readable(p)&&super::crash::readable(e)})}
+pub fn enabled()->bool{ON.load(Ordering::Relaxed)}
+pub fn owned()->bool{OWNED.load(Ordering::Relaxed)}
+pub fn pending()->bool{REQUEST.load(Ordering::Relaxed)}
+pub fn offhand_test()->bool{options().0}
+fn options()->(bool,bool){*CONFIG.get_or_init(||{
+    let text=std::fs::read_to_string(format!("{}\\kh1-dual-wield.ini",super::exe_dir())).unwrap_or_default();
+    let on=|key:&str,default:bool|text.lines().filter_map(|l|l.split(';').next()?.split_once('=')).find(|(k,_)|k.trim()==key).map_or(default,|(_,v)|matches!(v.trim(),"on"|"true"|"1"));
+    (on("offhand_only_test",false),on("remove_dual_wield",false))
+})}
+
+/// Sole ability-table extension; native entries 1..65 are copied without modification.
+pub unsafe fn ensure_table(base:usize){
+    if !READY.load(Ordering::Relaxed){return;}
+    let cur=rd::<u64>(base+TABLE_PTR) as usize;
+    let ours=*TABLE.get_or_init(||Box::leak(vec![0u8;127*12].into_boxed_slice()).as_mut_ptr() as usize);
+    if cur==ours||!readable(cur,65*12){return;}
+    let handle:unsafe extern "system" fn(usize)->u32=std::mem::transmute(base+TO_HANDLE);
+    let names=*NAMES.get_or_init(||{
+        let n=Box::leak(super::menu::encode(policy::NAME).into_boxed_slice()).as_ptr() as usize;
+        let h=Box::leak(super::menu::encode(policy::HELP).into_boxed_slice()).as_ptr() as usize;
+        (handle(n),handle(h))
+    });
+    if names.0==0||names.1==0 {return;}
+    let snapshot=std::slice::from_raw_parts(cur as *const u8,65*12).to_vec();
+    let Some(table)=policy::ability_table(&snapshot,names.0,names.1)else{return;};
+    if std::slice::from_raw_parts(cur as *const u8,65*12)!=snapshot.as_slice(){return;}
+    std::ptr::copy_nonoverlapping(table.as_ptr(),ours as *mut u8,table.len());
+    std::ptr::write_unaligned((base+TABLE_PTR) as *mut u64,ours as u64);
+    log("DUAL WIELD TABLE READY: only Dual Wield added (id126,0 AP); native ability entries retained byte-for-byte");
+}
+unsafe extern "system" fn table_load(){
+    let f:unsafe extern "system" fn()=std::mem::transmute(ORIG_LOAD.load(Ordering::Acquire));f();
+    ensure_table(super::sys::GetModuleHandleA(std::ptr::null()) as usize);
+}
+pub unsafe fn install(){
