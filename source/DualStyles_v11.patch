+/// Both native and imported sources publish world-space weapon bones in one transaction.
+/// Keeping a separate placement let v1 combine old world-space bones with a new placement.
+#[derive(Clone)]
+pub struct WeaponPose {
+    pub bones: [glam::Mat4; 13],
+    pub binding: Binding,
+    pub frame: u64,
+}
+
+impl WeaponPose {
+    pub fn new(local: [glam::Mat4; 13], placement: glam::Mat4, hand: glam::Mat4,
+        binding: Binding, frame: u64) -> Option<Self> {
+        let bones = local.map(|m| placement * m);
+        let hand = (placement * hand).w_axis.truncate();
+        let grip = bones[0].w_axis.truncate();
+        if !hand.is_finite() || !bones.iter().all(|m| m.is_finite()
+            && (m.w_axis.truncate() - grip).length() <= 300.0)
+            || (grip - hand).length() > 50.0 { return None; }
+        Some(Self { bones, binding, frame })
+    }
+
+    pub fn current(&self, binding: Binding, frame: u64) -> bool {
+        self.binding == binding && frame >= self.frame && frame - self.frame <= 1
+    }
