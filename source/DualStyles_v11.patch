+/// The regular MSET's second section is a table of u32 request descriptors. Bounds and
+/// record availability are checked at load time; no pointers from the file become addresses.
+pub fn request_slots(bytes:&[u8],records:usize)->Option<Vec<Option<usize>>>{
+    let rd=|at:usize|->Option<u32>{Some(u32::from_le_bytes(bytes.get(at..at.checked_add(4)?)?.try_into().ok()?))};
+    let count=rd(0)? as usize;
+    if !(2..=64).contains(&count) || records==0 || records>4096{return None;}
+    let start=rd(8)? as usize;
+    let end=if count>2{rd(12)? as usize}else{bytes.len()};
+    if start<4+count*4 || end<=start || end>bytes.len() || (end-start)%4!=0
+        || (end-start)/4>4096{return None;}
+    Some((start..end).step_by(4).map(|at|{
+        let word=rd(at)?;let slot=(word&0xFFF) as usize;
+        (word!=0 && slot<records).then_some(slot)
+    }).collect())
+}
