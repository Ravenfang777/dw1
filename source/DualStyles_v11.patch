+/// Custom poses use the pass's axes and the live actor's translation. Never derive a new
+/// placement from the bone array we previously overwrote, or reuse an old room's position.
+pub fn anchored_placement(mut pass: glam::Mat4, actor: [f32; 3]) -> Option<glam::Mat4> {
+    if !pass.is_finite() || !actor.iter().all(|v| v.is_finite())
+        || pass.x_axis.w.abs() > 1e-4 || pass.y_axis.w.abs() > 1e-4
+        || pass.z_axis.w.abs() > 1e-4 || pass.determinant().abs() < 1e-5 { return None; }
+    pass.w_axis = glam::Vec3::from(actor).extend(1.0);
+    Some(pass)
+}
