+pub fn spell_donor(spell:u8)->Option<u8>{
+    match spell { 0..=3=>Some(spell),4=>Some(2),5|6=>Some(3),_=>None }
+}
+
+/// Remove a donor clip's cumulative travel; its visual cannot move the actor or pull the
+/// drawn model away from it. Fractional frames interpolate the same cumulative root curve.
+pub fn unroot_visual(body:&mut [glam::Mat4],root:&[[f32;3]],frame:f32)->bool{
+    if !frame.is_finite() || frame<0.0 || !body.iter().all(|m|m.is_finite()){return false;}
+    if root.is_empty(){return true;}
+    let index=(frame as usize).min(root.len()-1);
+    let a=glam::Vec3::from(root[index]);let b=glam::Vec3::from(root[(index+1).min(root.len()-1)]);
+    if !a.is_finite() || !b.is_finite(){return false;}
+    let undo=glam::Mat4::from_translation(-a.lerp(b,frame.fract()));
+    for m in body{*m=undo* *m;}
+    true
