+/// A skinned joint is copied into the body's native draw palette every time.
+/// Verify the current model, rather than inferring freshness from helper worlds.
+unsafe fn skin_joint(instance:usize,joint:usize)->bool{
+    if !readable(instance,8){return false;}
+    let slot=rd::<u64>(instance)as usize;
+    if !readable(slot,8){return false;}
+    let header=rd::<u64>(slot)as usize;
+    if !readable(header,8) || rd::<u16>(header)!=SORA_BONES as u16{return false;}
+    let table=super::pose::ptr(rd::<u32>(header+4));
+    let at=table+joint*0x30+0x2c;
+    readable(at,4) && rd::<u32>(at)>>30==1
+}
