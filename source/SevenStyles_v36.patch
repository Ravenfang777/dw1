+//! Win64 bridge for the native, already-selected ground Guard branch.
+//! The surrounding native frame owns RBX (direction), RDI (actor), and its epilogue.
+
+fn jump(code:&mut Vec<u8>,to:usize){
+    code.extend_from_slice(&[0xff,0x25,0,0,0,0]);
+    code.extend_from_slice(&(to as u64).to_le_bytes());
+}
+
+pub(crate) fn guard_branch(callback:usize,context:usize,native_continue:usize,native_return:usize)->Vec<u8>{
+    let mut code=vec![0x48,0x8b,0xcf, // rcx = native actor (rdi)
+        0x48,0x83,0xec,0x20, // separate Win64 shadow space; native rsp is aligned
+        0x48,0xb8];
+    code.extend_from_slice(&(callback as u64).to_le_bytes());
+    code.extend_from_slice(&[0xff,0xd0,0x48,0x83,0xc4,0x20,0x84,0xc0,0x75,0x1b]);
+    // Declined: reproduce the overwritten argument setup, then resume the original.
+    code.extend_from_slice(&[0x4c,0x8b,0xc3,0x48,0xba]); // r8 = rbx; rdx = context
+    code.extend_from_slice(&(context as u64).to_le_bytes());
+    jump(&mut code,native_continue);
+    // Admitted: no native Guard context, motion, queue, voice or blocking flag is made.
+    jump(&mut code,native_return);
+    code
+}
+
+#[cfg(all(test,target_os="linux",target_arch="x86_64"))]
+mod tests{
+    use super::*;
+    use std::{ffi::c_void,sync::atomic::{AtomicBool,AtomicUsize,Ordering}};
+    static ADMIT:AtomicBool=AtomicBool::new(false);
+    static CALLED:AtomicUsize=AtomicUsize::new(0);
+    static ACTOR:AtomicUsize=AtomicUsize::new(0);
+    static FALLBACK:AtomicUsize=AtomicUsize::new(0);
+    static ARGS:[AtomicUsize;3]=[AtomicUsize::new(0),AtomicUsize::new(0),AtomicUsize::new(0)];
+    unsafe extern "win64" fn selected(actor:usize)->bool{
+        CALLED.fetch_add(1,Ordering::Relaxed);ACTOR.store(actor,Ordering::Relaxed);
+        ADMIT.load(Ordering::Relaxed)
+    }
+    unsafe extern "win64" fn original(actor:usize,context:usize,dir:usize)->usize{
+        FALLBACK.fetch_add(1,Ordering::Relaxed);
+        for (a,v) in ARGS.iter().zip([actor,context,dir]){a.store(v,Ordering::Relaxed);}
+        0xbeef
+    }
+    #[test] fn guard_bridge_executes_both_paths_with_the_native_win64_frame_and_arguments(){unsafe{
+        extern "C"{
+            fn mmap(at:*mut c_void,len:usize,prot:i32,flags:i32,fd:i32,off:isize)->*mut c_void;
+            fn munmap(at:*mut c_void,len:usize)->i32;
+        }
+        struct Mapping(*mut c_void);
+        impl Drop for Mapping{fn drop(&mut self){unsafe{munmap(self.0,4096);}}}
+        let memory=mmap(std::ptr::null_mut(),4096,7,0x22,-1,0);
+        assert_ne!(memory as isize,-1);let _mapping=Mapping(memory);let base=memory as usize;
+        let write=|offset:usize,code:&[u8]|std::ptr::copy_nonoverlapping(code.as_ptr(),(base+offset)as *mut u8,code.len());
+        // Same saved-register layout, stack alignment and epilogue as the verified
+        // native selector; this executes the production bridge, not a byte mirror.
+        let mut entry=vec![0x48,0x89,0x5c,0x24,0x08,0x48,0x89,0x74,0x24,0x10,
+            0x57,0x48,0x83,0xec,0x20,0x48,0x8b,0xc1,0x48,0x8b,0xfa,0x49,0x8b,0xd8,0xff,0xe0];
+        write(0,&entry);entry.clear();
+        let epilogue=[0x48,0x8b,0x5c,0x24,0x30,0x48,0x8b,0x74,0x24,0x38,0x48,0x83,0xc4,0x20,0x5f,0xc3];
+        let mut admitted=vec![0xb8,0xfe,0xca,0,0];admitted.extend_from_slice(&epilogue);write(128,&admitted);
+        let mut fallback=vec![0x48,0x8b,0xcf,0x48,0xb8];fallback.extend_from_slice(&(original as *const () as u64).to_le_bytes());
+        fallback.extend_from_slice(&[0xff,0xd0]);fallback.extend_from_slice(&epilogue);write(192,&fallback);
+        let context=0x1122_3344_5566_7788usize;
+        let code=guard_branch(selected as *const () as usize,context,base+192,base+128);write(256,&code);
+        let run:unsafe extern "win64" fn(usize,usize,usize)->usize=std::mem::transmute(base);
+        for admit in [false,true]{
+            ADMIT.store(admit,Ordering::Relaxed);CALLED.store(0,Ordering::Relaxed);FALLBACK.store(0,Ordering::Relaxed);
+            assert_eq!(run(base+256,0x12345678,0x87654321),if admit{0xcafe}else{0xbeef});
+            assert_eq!(CALLED.load(Ordering::Relaxed),1);assert_eq!(ACTOR.load(Ordering::Relaxed),0x12345678);
+            assert_eq!(FALLBACK.load(Ordering::Relaxed),usize::from(!admit));
+            if !admit{assert_eq!(ARGS.each_ref().map(|a|a.load(Ordering::Relaxed)),[0x12345678,context,0x87654321]);}
+        }
+    }}
+}
