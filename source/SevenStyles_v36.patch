+/// Rebuild a native joint from the current parent-local matrices and the root
+/// actually queued with the body. The root already includes local bone 0, so it
+/// must not be applied again. Published helper/hand world matrices are not inputs.
+pub fn native_joint_from_root(parents:&[i16],joint:usize,root:glam::Mat4,
+    mut local:impl FnMut(usize)->Option<glam::Mat4>)->Option<glam::Mat4>{
+    if !root.is_finite() || root.determinant().abs()<1e-6 || parents.first()!=Some(&-1)
+        || joint>=parents.len(){return None;}
+    let mut path=Vec::new();let mut at=joint;
+    while at!=0{
+        if path.len()>=parents.len(){return None;}
+        path.push(at);let p=*parents.get(at)?;
+        if p<0 || p as usize>=parents.len(){return None;}
+        at=p as usize;
+    }
+    let mut out=root;
+    for i in path.into_iter().rev(){
+        let m=local(i)?;
+        if !m.is_finite() || m.determinant().abs()<1e-6{return None;}
+        out*=m;
+    }
+    (out.is_finite() && out.determinant().abs()>=1e-6).then_some(out)
+}
