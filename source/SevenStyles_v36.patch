+                Err(e)=>reason=format!("candidate {i}: {e}"),
+            }
+        }
+        best.map(|(_,map)|map).ok_or_else(||format!("single-weapon free hand unresolved: primary={primary} candidates={} {reason}",candidates.len()))
+    }
