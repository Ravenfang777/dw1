+//! A measured correspondence for a separately indexed humanoid donor. Real weapon
+//! attachments anchor the arms; ordered ancestor paths anchor limbs. Position
+//! matching is allowed only inside the same branches of that anchored hierarchy.
+//! No animation channels, raw poses, weapon tracks or collision bones are relabelled.
+
+use super::*;
+
+/// Calibrated once at resource load, then shared by each KH1 actor binding.
+pub struct SourceLayout {
+    pub(super) parts: Vec<Part>,
+    pub(super) bind: Vec<Mat4>,
+    mapping: Vec<Option<usize>>,
+    pub landmarks: usize,
+    pub core_parts: usize,
+    pub max_normalized_error: f32,
+    pub hands: [usize; 2],
+}
+
+struct Body {
+    parent: Vec<Option<usize>>,
+    bind: Vec<Mat4>,
+    p: Vec<Vec3>,
+}
+
+impl Body {
+    fn read(bones: &[Bone], hands: [usize; 2]) -> Result<Self, String> {
+        if bones.is_empty() || bones.len() > 1024 || hands[0] == hands[1] || hands.iter().any(|&h| h >= bones.len()) {
+            return Err("invalid skeleton or real weapon attachment pair".into());
+        }
+        for (i, b) in bones.iter().enumerate() {
+            if b.index as usize != i || (i == 0 && b.parent >= 0) || (b.parent >= 0 && b.parent as usize >= i)
+                || !b.scale.iter().chain(&b.rotation).chain(&b.translation).all(|v| v.is_finite()) {
+                return Err(format!("invalid source hierarchy/transform at joint {i}"));
+            }
+        }
+        let bind = kh2_anim::Pose::bind(bones).bones;
+        if bind.iter().any(|m| !m.is_finite() || m.determinant().abs() < 1e-6) {
+            return Err("nonfinite or singular source bind".into());
+        }
+        let raw = positions(&bind);
+        let span = raw[hands[0]].distance(raw[hands[1]]);
+        if !span.is_finite() || span < 20.0 { return Err("collapsed source hand span".into()); }
+        let x = (raw[hands[0]] - raw[hands[1]]) / span;
+        let y = (Vec3::Y - x * x.y).normalize_or_zero();
+        if y == Vec3::ZERO { return Err("vertical source hand span".into()); }
+        let z = x.cross(y);
+        let p = raw.iter().map(|v| { let d = (*v - raw[0]) / span; Vec3::new(d.dot(x), d.dot(y), d.dot(z)) }).collect();
+        Ok(Self { parent: bones.iter().map(|b| (b.parent >= 0).then_some(b.parent as usize)).collect(), bind, p })
+    }
+
+    fn path(&self, mut i: usize) -> Vec<usize> {
+        let mut p = vec![i];
+        while let Some(j) = self.parent[i] { p.push(j); i = j; }
+        p.reverse(); p
+    }
+
+    fn under(&self, mut i: usize, root: usize) -> bool {
+        loop {
+            if i == root { return true; }
+            match self.parent[i] { Some(p) => i = p, None => return false }
+        }
+    }
+}
+
+struct Matcher {
+    a: Body,
+    b: Body,
+    map: Vec<Option<usize>>,
+    wanted: Vec<bool>,
+    separate: std::collections::HashSet<(usize, usize)>,
+}
+
+// Our bounds, in hand-span units, not game constants. Hierarchy/attachment
+// constraints and nondegenerate part frames are required in addition to distance.
+const MAX_ERROR: f32 = 0.20;
+const COINCIDENT: f32 = 1e-5;
+
+impl Matcher {
+    fn distinct(&self, a:usize, b:usize)->bool { self.separate.contains(&(a.min(b),a.max(b))) }
+
+    fn compatible(&self, i: usize, j: usize) -> bool {
+        if self.a.p[i].distance(self.b.p[j]) > MAX_ERROR { return false; }
+        for (r, m) in self.map.iter().enumerate().filter_map(|(r, m)| m.map(|m| (r, m))) {
+            if i == r { if j != m { return false; } continue; }
+            let (down, up) = (self.a.under(i, r), self.a.under(r, i));
+            if down {
+                if !self.b.under(j, m) { return false; }
+            } else if up {
+                if !self.b.under(m, j) { return false; }
+            } else if self.b.under(j, m) || self.b.under(m, j) { return false; }
+            if j == m && self.distinct(i,r) { return false; }
+        }
+        true
+    }
+
+    /// Ordered paths allow extra donor helpers and omit unmeasured source helpers.
+    /// Source wrappers between parts may share a donor joint; measured segments
+    /// and poles cannot collapse.
+    fn path(&self, i: usize, j: usize) -> Option<(f32, Vec<(usize, usize)>)> {
+        let a:Vec<_> = self.a.path(i).into_iter().filter(|&r|self.wanted[r] || r==i).collect();
+        let b = self.b.path(j);
+        let mut cost = vec![vec![f32::INFINITY; b.len()]; a.len()];
+        let mut prev = vec![vec![usize::MAX; b.len()]; a.len()];
+        for (r, &ri) in a.iter().enumerate() {
+            for (s, &sj) in b.iter().enumerate() {
+                if !self.compatible(ri, sj) || (r + 1 == a.len() && s + 1 != b.len()) { continue; }
+                let own = self.a.p[ri].distance_squared(self.b.p[sj]);
+                if r == 0 { if s == 0 { cost[r][s] = own; } continue; }
+                for t in 0..=s {
+                    if s == t && self.distinct(ri,a[r - 1]) { continue; }
+                    let c = cost[r - 1][t] + own;
+                    if c < cost[r][s] { cost[r][s] = c; prev[r][s] = t; }
+                }
+            }
+        }
+        let value = cost[a.len() - 1][b.len() - 1];
+        if !value.is_finite() { return None; }
+        let mut at = b.len() - 1;
+        let mut pairs = Vec::new();
+        for r in (0..a.len()).rev() { pairs.push((a[r], b[at])); if r > 0 { at = prev[r][at]; } }
+        // A single alignment must satisfy the same ancestry rules internally too.
+        for &(r,s) in &pairs {
+            if pairs.iter().any(|&(u,v)|s==v && self.distinct(r,u)){return None;}
+        }
+        Some((value, pairs))
+    }
+
+    fn accept(&mut self, pairs: Vec<(usize, usize)>) { for (i, j) in pairs { self.map[i] = Some(j); } }
+
+    fn point(&mut self, i: usize) -> Result<(), String> {
+        if self.map[i].is_some() { return Ok(()); }
+        let mut options: Vec<_> = (0..self.b.p.len()).filter(|&j| self.compatible(i, j)).collect();
+        options.sort_by(|&a, &b| self.a.p[i].distance_squared(self.b.p[a]).total_cmp(&self.a.p[i].distance_squared(self.b.p[b])));
+        let best = options.iter().filter_map(|&j| self.path(i, j)).min_by(|a, b| a.0.total_cmp(&b.0));
+        if let Some((_, pairs)) = best { self.accept(pairs); Ok(()) }
+        else { Err(format!("no hierarchy/geometry correspondence for Sora landmark {i} at {:.3?}; mapped={}", self.a.p[i], self.map.iter().flatten().count())) }
+    }
+
+    fn leg(&mut self, side: &Side) -> Result<(), String> {
+        let mut best: Option<(f32, Vec<(usize, usize)>)> = None;
+        for j in 1..self.b.p.len() {
+            if self.b.p[j].y > -0.15 || !self.compatible(side.ankle, j) { continue; }
+            let below: Vec<_> = (j..self.b.p.len()).filter(|&k| self.b.under(k, j)).collect();
+            let nearest = |i: usize| below.iter().map(|&k| self.a.p[i].distance_squared(self.b.p[k])).fold(f32::INFINITY, f32::min);
+            let (heel, toe) = (nearest(side.heel), nearest(side.toe));
+            if heel > 0.12f32.powi(2) || toe > 0.12f32.powi(2) { continue; }
+            let Some((cost, pairs)) = self.path(side.ankle, j) else { continue; };
+            let cost = cost + heel + toe;
+            if best.as_ref().is_none_or(|v| cost < v.0) { best = Some((cost, pairs)); }
+        }
+        let (_, pairs) = best.ok_or_else(|| format!("no ordered hip/knee/ankle path for Sora ankle {}", side.ankle))?;
+        self.accept(pairs);
+        self.point(side.heel)?; self.point(side.toe)?;
+        Ok(())
+    }
+}
+
+fn mapped_part(p: Part, map: &[Option<usize>]) -> Part {
+    let m = |i: usize| map.get(i).copied().flatten().unwrap_or(usize::MAX);
+    let pair = |(a, b)| (m(a), m(b));
+    match p {
+        Part::Torso { right, up } => Part::Torso { right: pair(right), up: pair(up) },
+        Part::Aim { from, to, pole } => Part::Aim { from: m(from), to: m(to), pole: match pole {
+            Pole::Line(a, b) => Pole::Line(m(a), m(b)),
+            Pole::Joint { a, b, c, fallback, flip } => Pole::Joint { a: m(a), b: m(b), c: m(c), fallback: pair(fallback), flip },
+            Pole::Knee { a, b, c, hips } => Pole::Knee { a: m(a), b: m(b), c: m(c), hips: pair(hips) },
+            // shin is a part index, NOT a source bone index.
+            Pole::Foot { shin, ankle, sign } => Pole::Foot { shin, ankle: m(ankle), sign },
+        } },
+    }
+}
+
+impl SourceLayout {
+    pub fn build(reference: &[Bone], reference_hands: [usize; 2], donor: &[Bone], hands: [usize; 2]) -> Result<Self, String> {
+        let (a, b) = (Body::read(reference, reference_hands)?, Body::read(donor, hands)?);
+        let (parts, _, _) = layout();
+        let mut core = Vec::new();
+        let mut separate = std::collections::HashSet::new();
+        for p in &parts {
+            let points=source_points(p);
+            if core_source_part(p){core.extend(points.iter().copied());}
+            // Only endpoints measured together must be different. A source-only
+            // helper between parts may merge into an actual donor joint.
+            for &i in &points {for &j in &points {if i!=j && i<reference.len() && j<reference.len()
+                && a.p[i].distance(a.p[j])>COINCIDENT {separate.insert((i.min(j),i.max(j)));}}}
+        }
+        core.sort_unstable();core.dedup();
+        if core.iter().any(|&i|i>=reference.len()){return Err("reference missing core landmarks".into());}
+        let mut wanted=vec![false;reference.len()];
+        for &i in core.iter().chain(&reference_hands).chain(&[0]){wanted[i]=true;}
+        // Retain branch points of the measured tree, but do not demand every
+        // Sora helper/wardrobe ancestor have a corresponding Roxas bone.
+        for &i in &core {for &j in &core {
+            if let Some(lca)=a.path(i).into_iter().rev().find(|&k|a.under(j,k)){wanted[lca]=true;}
+        }}
+        let mut m = Matcher { map: vec![None; reference.len()], a, b, wanted, separate };
+        m.map[0] = Some(0);
+        for (a, b) in reference_hands.into_iter().zip(hands) { m.map[a] = Some(b); }
+        for (a, b) in reference_hands.into_iter().zip(hands) {
+            let (_, pairs) = m.path(a, b).ok_or_else(|| format!("no ordered arm path between real weapon joints {a}->{b}"))?;
+            m.accept(pairs);
+        }
+        m.leg(&PLUS_X)?; m.leg(&minus_x())?;
+        // Parents before descendants; the landmark's matching path also admits
+        // intermediate nodes. Wardrobe branches not measured by any part are ignored.
+        for &i in &core { if i >= m.map.len() { return Err(format!("reference missing landmark {i}")); } m.point(i)?; }
+        let core_parts = parts.iter().filter(|p| core_source_part(p)).count();
+        let mapped: Vec<_> = parts.iter().copied().map(|p| mapped_part(p, &m.map)).collect();
+        let f = frames(&mapped, &positions(&m.b.bind));
+        for (i, _) in parts.iter().enumerate().filter(|(_, p)| core_source_part(p)) {
+            if f[i].is_none_or(|q| !q.is_finite()) { return Err(format!("mapped core part {i} is degenerate: {:?}", source_points(&mapped[i]))); }
+        }
+        // Finger detail is optional. A missing branch inherits its already
+        // admitted hand instead of preventing every body move from loading.
+        for p in parts.iter().filter(|p| !core_source_part(p)) {
+            let saved = m.map.clone();
+            if source_points(p).into_iter().any(|i| i >= m.map.len() || m.point(i).is_err()) { m.map = saved; }
+        }
+        let parts = parts.into_iter().map(|p| mapped_part(p, &m.map)).collect();
+        let max_normalized_error = core.iter().map(|&i| m.a.p[i].distance(m.b.p[m.map[i].unwrap()])).fold(0.0, f32::max);
