+//! Real KH2 MAG/BDX/PAX visuals over proven native Dual B casts. Visual-only World:
+//! no damage/heal/MP, native motion, inventory, ability, Drive or audio writes.
+use super::{addr::Rva,dual,dual_cast,fx12,hook,log,pose,takeover};
+use crate::dual_wield::Binding;
+use glam::{Mat4,Quat,Vec3};
+use kh2_fx::{Camera,EffectHandle,Effects,Frame,Library};
+use kh2_magic::{Magic,ObjId,SpellFile,World};
+use std::collections::HashMap;
+use std::sync::{Arc,Mutex,atomic::{AtomicU32,AtomicUsize,Ordering}};
+
+const WORLD_PASS:Rva=Rva(0x1EADD0);
+const SORA:ObjId=1;
+const TARGET:ObjId=2;
+static ORIG:AtomicUsize=AtomicUsize::new(0);
+static BASE:AtomicUsize=AtomicUsize::new(0);
+static STATE:Mutex<Option<Runtime>>=Mutex::new(None);
+static NOTES:AtomicU32=AtomicU32::new(0);
+struct Package{fx:Effects,tex:u32,frame:Frame,file:usize}
+struct Runtime{
+    magic:Magic,packages:Vec<Option<Package>>,scope:Option<Binding>,last_frame:u64,
+    seen:Option<u64>,casting:Option<(u64,f32,bool)>,handles:HashMap<u64,(usize,EffectHandle,bool)>,
+    frame:Frame,credit:f64,age:u32,
+}
+impl Runtime{
+    fn clear(&mut self){
+        self.magic.casts.clear();self.magic.effects.clear();self.magic.attacks.clear();self.magic.loose.clear();
+        self.magic.take_events();for p in self.packages.iter_mut().flatten(){p.fx.clear();}
+        self.scope=None;self.seen=None;self.casting=None;self.handles.clear();self.credit=0.0;self.age=0;
+    }
+}
+unsafe fn rd<T:Copy>(p:usize)->T{std::ptr::read_unaligned(p as *const T)}
+fn readable(p:usize,n:usize)->bool{p>=0x10000 && p.checked_add(n-1).is_some_and(|e|unsafe{super::crash::readable(p)&&super::crash::readable(e)})}
+fn note(s:impl AsRef<str>){if NOTES.fetch_add(1,Ordering::Relaxed)<100{log(s.as_ref());}}
+fn flip()->Mat4{Mat4::from_scale(Vec3::new(1.0,-1.0,1.0))}
+fn place(pos:Vec3,dir:Vec3)->Mat4{
+    flip()*Mat4::from_rotation_translation(Quat::from_rotation_arc(Vec3::Z,dir.try_normalize().unwrap_or(Vec3::Z)),pos)*flip()
+}
+unsafe fn native_level(base:usize,spell:u8)->u8{
+    let at=base+Rva(0x2D23580)+spell as usize*0x38;
+    if readable(at,4){let v=rd::<i32>(at);if (1..=3).contains(&v){return v as u8;}}
+    let ptr=base+Rva(0x28695A0);
+    if readable(ptr,8){let s=rd::<u64>(ptr) as usize;if readable(s+0x492+spell as usize,1){
+        let v=rd::<u8>(s+0x492+spell as usize);if (1..=3).contains(&v){return v;}
+    }}1
+}
+unsafe fn visible(base:usize,b:Binding)->bool{
+    dual::ranged() && readable(b.actor,0x448) && rd::<u32>(base+Rva(0x298D3A0))==0
+        && pose::ptr(rd::<u32>(b.actor+0x440))==0 && rd::<u32>(b.actor+0x444)&1==0
+}
+
+#[derive(Clone)]
+struct Obj{id:ObjId,pos:Vec3,air:bool}
+struct Snapshot{objects:Vec<Obj>,body:Vec<Mat4>,world:Mat4,facing:f32,motion:u16,floor:f32,rng:u32}
+impl Snapshot{
+    fn obj(&self,id:ObjId)->Option<&Obj>{self.objects.iter().find(|o|o.id==id)}
+    fn game_bone(&self,code:u16)->Option<Mat4>{
+        match code{
+            0x4000=>Some(self.world*Mat4::from_scale(Vec3::new(1.0,-1.0,-1.0))),
+            0x4001=>self.body.first().map(|b|Mat4::from_translation(self.world.transform_point3(b.w_axis.truncate()))),
+            0x4002=>Some(self.world),
+            0x4003..=0x4008=>{
+                let second=(code-1)&1==1;
+                if let Some(b)=super::leftblade::final_blade(second){
+                    let along=match code{0x4003|0x4004=>1.0,0x4005|0x4006=>0.0,_=>0.5};
+                    return Some(b*Mat4::from_translation(Vec3::new(-78.0*along,0.0,0.0)));
+                }
+                self.body.get(178).map(|b|self.world* *b)
+            }
+            c=>self.body.get(c as usize).map(|b|self.world* *b),
+        }
+    }
+}
+impl World for Snapshot{
+    fn exists(&self,o:ObjId)->bool{self.obj(o).is_some()}
+    fn pos(&self,o:ObjId)->Vec3{self.obj(o).map_or(Vec3::ZERO,|o|o.pos)}
+    fn facing(&self,_:ObjId)->f32{self.facing}
+    fn motion(&self,_:ObjId)->u16{self.motion}
+    fn airborne(&self,o:ObjId)->bool{self.obj(o).is_some_and(|o|o.air)}
+    fn jumping(&self,o:ObjId)->bool{self.airborne(o)}
+    fn bone(&self,o:ObjId,c:u16)->Option<Mat4>{
+        if o==SORA{match c{
+            0x4000=>Some(Mat4::from_rotation_translation(Quat::from_rotation_y(self.facing),self.pos(SORA))),
+            0x4001=>Some(Mat4::from_translation(self.pos(SORA)+Vec3::Y*90.0)),
+            _=>self.game_bone(c).map(|b|flip()*b),
+        }}
+        else{self.obj(o).map(|o|Mat4::from_translation(o.pos+Vec3::Y*60.0))}
+    }
+    fn target_point(&self,o:ObjId)->Vec3{self.pos(o)+Vec3::Y*60.0}
