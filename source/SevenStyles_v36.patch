+unsafe fn snapshot(base:usize,b:Binding,motion:u16)->Option<Snapshot>{
+    let (body,mut world)=pose::kh2_pose(|p,w|(p.to_vec(),*w))?;
+    let p=rd::<[f32;3]>(b.actor+0x10);if !p.iter().all(|v|v.is_finite()){return None;}
+    world=crate::dual_wield::anchored_placement(world,p)?;
