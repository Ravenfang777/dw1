+    pub fn single_weapon(reference:&[Bone],reference_hands:[usize;2],donor:&[Bone],primary:usize,free_hand:Option<usize>)->Result<Self,String>{
+        // Validate before evaluating a candidate. Joint zero is only a temporary
+        // validation seed; it is never admitted as the free hand.
+        let b=Body::read(donor,[primary,free_hand.unwrap_or(0)])?;
+        let p=positions(&b.bind);let root=p[0];let held=p[primary];
+        let width=(held.x-root.x).abs()*2.0;
+        if !width.is_finite()||width<20.0{return Err("single-weapon palm is not lateral to the body root".into());}
+        let mut children=vec![0usize;donor.len()];
+        for b in donor{if b.parent>=0{children[b.parent as usize]+=1;}}
+        let leaves=|joint:usize|(0..donor.len()).filter(|&i|children[i]==0&&b.under(i,joint)).count();
+        // Some rigs attach a weapon to a leaf helper below the actual palm.
+        // Calibrate from its nearest finger-bearing ancestor, within hand range;
+        // the real attachment in WeaponRig remains untouched.
+        let palm=|joint:usize|b.path(joint).into_iter().rev().find(|&i|
+            p[i].distance(p[joint])/width<0.10 && (3..=16).contains(&leaves(i)));
+        let primary=palm(primary).ok_or("single-weapon attachment has no nearby finger-bearing palm")?;
+        if let Some(free)=free_hand{
+            let free=palm(free).ok_or("free-hand metadata has no nearby finger-bearing palm")?;
+            return Self::build(reference,reference_hands,donor,[primary,free]);
+        }
+        let held=p[primary];let expected=Vec3::new(root.x*2.0-held.x,held.y,held.z);
+        let held_leaves=leaves(primary);
+        let mut candidates:Vec<_>=(1..donor.len()).filter(|&i|i!=primary && !b.under(i,primary) && !b.under(primary,i)
+            && (p[i].x-root.x)*(held.x-root.x)<0.0 && p[i].distance(expected)/width<0.25
+            && (3..=16).contains(&leaves(i))).collect();
+        let rank=|i:usize|p[i].distance(expected)/width+(leaves(i).abs_diff(held_leaves) as f32)*0.002;
