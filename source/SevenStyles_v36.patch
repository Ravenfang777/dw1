+                && battle.attack_for_level(attack,0,0).is_some_and(|a|matches!(a.kind,0|1)&&a.stat_source<=1&&a.power>0)
+        },
+        WindowKind::NoGravity|WindowKind::WeaponTrail=>true,_=>false,
+    });
