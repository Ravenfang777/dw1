+                let magi=pose::kh2().and_then(|k|k.magi.get(sub).map(|r|r.to_vec())).unwrap_or_else(||vec![0;kh2_formats::pref::MagiTable::RECORD]);
+                match rt.magic.cast(file,SORA,s.spell,sub,&magi,&mut world){Ok(_)=>{
+                    let release=pose::kh2().and_then(|k|k.final_form.as_ref()).and_then(|f|f.character.moveset.clips.get(&motion))
+                        .and_then(|c|c.events.iter().find(|e|matches!(e.kind,character_core::EventKind::MagicCast(_))).map(|e|e.frame as f32)).unwrap_or(0.0);
+                    rt.casting=Some((s.cast_id,release,false));rt.seen=Some(s.cast_id);rt.age=0;
+                    note(format!("DUAL B REAL KH2 SPELL FX: spell={} level={level} air={} Final_sub={sub} cast_id={}; visual script only; native effects may remain",s.spell,s.air,s.cast_id));
+                },Err(e)=>{rt.seen=Some(s.cast_id);note(format!("DUAL B visual script start failed: {e}"));}}
+            }
+        }
+    }
+    if let Some((id,release,done))=rt.casting{
+        if let Some(s)=sample.as_ref().filter(|s|s.cast_id==id){
+            if !done && s.frame>=release{rt.magic.release(SORA,&mut world);rt.casting=Some((id,release,true));}
+        }else{if !done{rt.magic.cancel(SORA);}rt.casting=None;}
+    }
+    let delta=crate::dual_wield::animation_step(rd::<f32>(base+Rva(0x23405DC)));
+    rt.credit=(rt.credit+delta).min(4.0);
