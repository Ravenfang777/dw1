+    fn pose(count:usize)->Arc<Interpolated>{Arc::new(Interpolated{bone_count:count,total_joints:count,frame_count:30,
+        frame_start:0.,frame_end:30.,fps:60.,frame_return:0.,initial_pose:vec![],forward:vec![],inverse:vec![],ik_helpers:vec![],joints:vec![],constraints:vec![],activations:vec![],limiters:vec![],expressions:vec![],nodes:vec![],external_effectors:vec![]})}
+    fn shape(group:u8,bone:usize)->BoneShape{BoneShape{group,kind:6,shape:3,argument:0,bone:Some(bone),offset:[0.,0.,20.],lift:0.,radius:6.,height:0.}}
