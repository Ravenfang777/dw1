+//! A host combo for final-battle Riku's empty PTYA profile. Physical strike
+//! windows/ATKP, poses, timing and root remain authored KH2 data. Row ordering,
+//! alias slots and missing follow-up/air routing are our adapter, not native PTYA.
+use std::collections::HashSet;
+use character_core::{Clip,ComboRow,EventKind,Moveset,Window,WindowKind};
+use kh2_formats::battle::Battle;
+use crate::sora::Rig;
+
+#[derive(Clone,Debug)]
+pub struct ComboBinding {
+    pub host:u16,
+    pub source:u16,
+    pub air:bool,
+    pub finisher:bool,
+    pub followup:u32,
+}
+
+pub struct PreparedCombos {
+    pub moveset:Moveset,
+    pub rig:Rig,
+    pub bindings:Vec<ComboBinding>,
+    pub hand_groups:Vec<u8>,
+    pub shared_air:bool,
+}
+
+fn under(rig:&Rig,mut bone:usize,hand:usize)->bool{
+    for _ in 0..rig.skeleton.len(){
+        if bone==hand{return true;}
+        let Some(b)=rig.skeleton.get(bone)else{return false;};
+        if b.parent<0 || b.parent as usize>=bone{return false;}
+        bone=b.parent as usize;
+    }
+    false
+}
+
+/// A contact stored on the body may still be the held sword. Admit that only
+/// when every attack shape of its group is attached to the real primary hand
+/// or its descendants. Mixed body/kick, root and unbound groups are excluded.
+fn primary_hand_groups(rig:&Rig)->Vec<u8>{
+    let Some(hand)=rig.weapons.first().and_then(|w|w.bone)else{return Vec::new();};
+    let mut groups:Vec<_>=rig.body_shapes.iter().filter(|s|s.kind==6).map(|s|s.group).collect();
+    groups.sort_unstable();groups.dedup();
+    groups.retain(|g|rig.body_shapes.iter().filter(|s|s.kind==6&&s.group==*g)
+        .all(|s|s.bone.is_some_and(|b|under(rig,b,hand))));
+    groups
+}
+
+fn physical(rig:&Rig,hand_groups:&[u8],battle:&Battle,w:&Window,length:u32)->bool{
+    let WindowKind::Hitbox{attack,group,weapon,..}=w.kind else{return false;};
+    if w.start>=length || w.end.unwrap_or(length).min(length)<=w.start{return false;}
+    let shape=match weapon{
+        0=>hand_groups.contains(&group),
+        1=>rig.weapons.first().is_some_and(|r|r.shapes.iter().any(|s|s.kind==6&&s.group==group
+            && s.bone.is_none_or(|b|b<r.skeleton.len()))),
+        _=>false,
+    };
+    shape && battle.attack_for_level(attack,0,99).is_some_and(|a|
+        matches!(a.kind,0|1)&&a.stat_source==0&&a.power>0&&a.attack_kind_flags&4==0)
+}
+
+#[derive(Clone)]
+struct Attack {clip:Clip,air:bool,finisher:bool,last_hit:u32}
+
+fn candidates(moves:&Moveset,rig:&Rig,battle:&Battle,groups:&[u8])->Vec<Attack>{
+    let mut all=Vec::new();
+    for (&motion,clip) in &moves.clips{
+        // 0..5 are the shared movement slots, never a basic strike.
+        if motion<=5 || !rig.motions.contains_key(&motion) || !(4..=3600).contains(&clip.length)
+            || clip.root.len()<clip.length as usize+1 || clip.root.iter().flatten().any(|v|!v.is_finite())
+            || clip.events.iter().any(|e|matches!(e.kind,EventKind::MagicCast(_))){continue;}
+        if moves.combo_rows.iter().any(|r|r.motion==motion&&r.ability!=0)
+            && !moves.combo_rows.iter().any(|r|r.motion==motion&&r.ability==0&&matches!(r.kind,1..=3)){continue;}
+        let hits:Vec<_>=clip.windows.iter().filter(|w|physical(rig,groups,battle,w,clip.length)).copied().collect();
+        if hits.is_empty(){continue;}
+        let first=hits.iter().map(|w|w.start).min().unwrap();
+        let last_hit=hits.iter().map(|w|w.end.unwrap_or(clip.length).min(clip.length)).max().unwrap();
+        let flags=hits.iter().filter_map(|w|if let WindowKind::Hitbox{attack,..}=w.kind{
+            battle.attack_for_level(attack,0,99).map(|a|a.attack_kind_flags)}else{None}).fold(0,|a,b|a|b);
+        let air=flags&2!=0 || clip.has(first,|k|matches!(k,WindowKind::Air))
+            || clip.has(first,|k|matches!(k,WindowKind::NoGravity))&&!clip.has(first,|k|matches!(k,WindowKind::Grounded));
+        let mut clean=clip.clone();
+        clean.events.clear();
+        clean.windows.retain(|w|match w.kind{
+            WindowKind::Hitbox{..}=>physical(rig,groups,battle,w,clip.length),
+            WindowKind::Guard{..}|WindowKind::Invulnerable|WindowKind::OfferCommand(_)|WindowKind::ScriptRange(_)=>false,
+            _=>true,
+        });
+        if !clean.windows.iter().any(|w|matches!(w.kind,WindowKind::WeaponTrail)){
+            clean.windows.extend(hits.iter().map(|w|Window{start:w.start,end:w.end,kind:WindowKind::WeaponTrail}));
+        }
+        all.push(Attack{clip:clean,air,finisher:flags&3!=0,last_hit});
+    }
+    all.sort_by_key(|a|a.clip.motion);all
+}
+
+fn row(id:u8,motion:u16,air:bool,finisher:bool,sub:i8)->ComboRow{
+    // PTYA flag bits documented in the existing native table reader.
+    const FLAG_AIR:u32=1;const FLAG_FINISHER:u32=4;
+    ComboRow{id,kind:3,sub,combo_offset:0,flag:if air{FLAG_AIR}else{0}|if finisher{FLAG_FINISHER}else{0},
+        motion,next_motion:if air{4}else{0},jump:0.,jump_min:0.,jump_max:0.,speed_min:0.,speed_max:0.,
+        near:0.,far:1000.,low:-1000.,high:1000.,inner_min:-1.,inner_max:1.,blend_time:0.,distance_adjust:0.,ability:0,score:0}
+}
+
+/// Build two alternating base strikes and a finisher per context. Actual
+/// contact windows and damage records are never invented. An absent air lane
+/// reuses the admitted melee clips with a separate host air hold. Existing
+/// playable PTYA callers do not need this adapter.
+pub fn prepare_combos(moves:&Moveset,rig:&Rig,battle:&Battle)->Result<PreparedCombos,String>{
+    if rig.weapons.len()!=1{return Err("Riku combo adapter requires exactly one real weapon".into());}
+    let hand_groups=primary_hand_groups(rig);
+    let all=candidates(moves,rig,battle,&hand_groups);
+    if all.is_empty(){return Err(format!("Riku has no loaded physical melee clips with valid ATKP and primary weapon/hand shapes; clips={} poses={} hand_groups={hand_groups:?}",moves.clips.len(),rig.motions.len()));}
+    let mut ground:Vec<_>=all.iter().filter(|a|!a.air).cloned().collect();
+    let mut air:Vec<_>=all.iter().filter(|a|a.air).cloned().collect();
+    if ground.is_empty(){ground=all.clone();}
+    let shared_air=air.is_empty();if shared_air{air=ground.clone();}
+    let mut out=PreparedCombos{moveset:moves.clone(),rig:rig.clone(),bindings:Vec::new(),hand_groups,shared_air};
+    out.moveset.combo_rows.clear();
+    let mut used:HashSet<u16>=moves.clips.keys().chain(rig.motions.keys()).copied().collect();
+    for w in &rig.weapons{used.extend(w.motions.keys().copied());}
+    for (is_air,lane,first_id) in [(false,ground,1u8),(true,air,4u8)]{
+        let base:Vec<_>=lane.iter().filter(|a|!a.finisher).collect();
+        let base=if base.is_empty(){lane.iter().collect::<Vec<_>>()}else{base};
+        let finisher=lane.iter().find(|a|a.finisher).unwrap_or_else(||lane.last().unwrap());
+        let selected=[base[0],base.get(1).copied().unwrap_or(base[0]),finisher];
+        let mut rows=Vec::new();
+        for (stage,a) in selected.into_iter().enumerate(){
+            let host=(96..=255u16).rev().find(|i|!used.contains(i)).ok_or("no unused host motion slots for Riku combo aliases")?;
+            used.insert(host);
+            let body=rig.motions.get(&a.clip.motion).ok_or("selected Riku body pose missing")?.clone();
+            out.rig.motions.insert(host,body);
+            for (dst,src) in out.rig.weapons.iter_mut().zip(&rig.weapons){
+                if let Some(pose)=src.motions.get(&a.clip.motion).or_else(||src.motions.get(&0)){dst.motions.insert(host,pose.clone());}
+            }
+            let mut clip=a.clip.clone();clip.motion=host;
+            let fin=stage==2;
+            if fin{clip.windows.retain(|w|!matches!(w.kind,WindowKind::Combo|WindowKind::Finisher));}
+            let followup=clip.windows.iter().filter(|w|matches!(w.kind,WindowKind::Combo)&&w.start<clip.length)
+                .map(|w|w.start).min().unwrap_or(a.last_hit.min(clip.length-1));
+            if !fin&&!clip.windows.iter().any(|w|matches!(w.kind,WindowKind::Combo)&&w.start<clip.length){
+                clip.windows.push(Window{start:followup,end:Some(clip.length),kind:WindowKind::Combo});
+            }
+            if is_air&&shared_air{
+                clip.windows.retain(|w|!matches!(w.kind,WindowKind::Grounded|WindowKind::Air));
+                clip.windows.push(Window{start:0,end:Some(clip.length),kind:WindowKind::NoGravity});
+            }
+            out.bindings.push(ComboBinding{host,source:a.clip.motion,air:is_air,finisher:fin,followup});
+            out.moveset.clips.insert(host,clip);
+            let sub=if stage==0{first_id+1}else{first_id};
+            rows.push(row(first_id+stage as u8,host,is_air,fin,if fin{-1}else{sub as i8}));
+        }
+        // Finisher condition takes priority only when the native combo count is ready.
+        out.moveset.combo_rows.extend([rows[2].clone(),rows[0].clone(),rows[1].clone()]);
+    }
+    Ok(out)
+}
+
