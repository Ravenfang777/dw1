+/// One native physics callback. Only accepted native casts can start the visual script.
+pub unsafe fn step(actor:usize){
+    let base=BASE.load(Ordering::Relaxed);if base==0{return;}
+    let b=dual::binding().filter(|b|b.actor==actor);
+    let sample=b.filter(|b|visible(base,*b)).and_then(|b|dual_cast::sample(actor,b.instance));
+    let Ok(mut g)=STATE.try_lock() else{return;};let Some(rt)=g.as_mut() else{return;};
+    let Some(b)=b.filter(|b|visible(base,*b)) else{rt.clear();return;};
+    let frame=takeover::GAME_FRAME.load(Ordering::Relaxed);if rt.last_frame==frame{return;}rt.last_frame=frame;
+    if rt.scope!=Some(b){rt.clear();rt.scope=Some(b);}
