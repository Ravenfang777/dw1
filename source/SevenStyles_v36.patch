@@ -0,0 +1,71 @@
+//! Replace native-committed actions; native input/ability selection has already happened.
+use super::{addr::Rva,dual,hook,log,pose,takeover};
+use std::sync::atomic::{AtomicBool,AtomicU32,AtomicUsize,Ordering};
+
+const ROLL:Rva=Rva(0x2C7CB0);
+const SUPERGLIDE:Rva=Rva(0x2B05C0);
+const SET_STATE:Rva=Rva(0x2AF7D0);
+const PAD:Rva=Rva(0x298D4A0);
+static ORIG_ROLL:AtomicUsize=AtomicUsize::new(0);
+static ORIG_GLIDE:AtomicUsize=AtomicUsize::new(0);
+static LATCH:AtomicBool=AtomicBool::new(false);
+unsafe fn rd<T:Copy>(p:usize)->T{std::ptr::read_unaligned(p as *const T)}
+fn readable(p:usize,n:usize)->bool{p>=0x10000 && p.checked_add(n-1).is_some_and(|e|unsafe{super::crash::readable(p)&&super::crash::readable(e)})}
+unsafe fn free(actor:usize)->bool{
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    actor==takeover::sora_actor() && readable(actor,0x448)
+        && rd::<u32>(base+Rva(0x298D3A0))==0 && pose::ptr(rd::<u32>(actor+0x440))==0
+        && rd::<u32>(actor+0x444)&1==0 && rd::<u32>(actor)&0x0100_0000==0
+}
+
+pub unsafe fn frame(){
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    if !dual::close() || readable(base+PAD+4,4) && rd::<u32>(base+PAD+4)&0x0080_0010==0{
+        LATCH.store(false,Ordering::Relaxed);
+    }
+}
+unsafe extern "system" fn roll(actor:usize){
+    if dual::ranged() && free(actor){
+        if dual::roll_session() && (dual::owned()||dual::pending()) {return;}
+        if dual::request_roll(actor){
+            takeover::dual_native_selected();
+            log("DUAL B NATIVE ROLL REPLACED: committed native Dodge Roll intercepted before its motion/flags/voice; moving spin queued");return;
+        }
+        static N:AtomicU32=AtomicU32::new(0);
+        if N.fetch_add(1,Ordering::Relaxed)<12{
+            log(&format!("DUAL B ROLL ADMISSION FAILED: spin_data={} left_ready={} body_ready={} owned={} pending={}; native fallback",
+                pose::kh2().is_some_and(|k|k.dual_b_roll.is_some()),super::leftblade::ready(),pose::sora_body_seen(500),dual::owned(),dual::pending()));
+        }
+    }
+    let f:unsafe extern "system" fn(usize)=std::mem::transmute(ORIG_ROLL.load(Ordering::Acquire));f(actor);
+}
+unsafe extern "system" fn superglide(actor:usize){
+    let eligible=dual::close() && free(actor)
+        && pose::kh2().is_some_and(|k|k.dual_a_finisher.is_some());
+    if eligible && LATCH.load(Ordering::Relaxed){return;}
+    let f:unsafe extern "system" fn(usize)=std::mem::transmute(ORIG_GLIDE.load(Ordering::Acquire));f(actor);
+    if !eligible || !readable(actor,0x4b0) || rd::<i32>(actor+0x70)!=21{return;}
+    let work=pose::ptr(rd::<u32>(actor+0x148));
+    if !readable(work,0x108) || rd::<u32>(work+0x104)&1==0{return;}
+    // The original has proved native Superglide eligibility. Leave its state normally,
+    // then run one real finisher with no inherited Superglide speed.
+    if dual::request_finisher(actor){
+        takeover::dual_prepare_finisher();
+        let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+        let set:unsafe extern "system" fn(usize,i32)->u32=std::mem::transmute(base+SET_STATE);
+        set(actor,0);LATCH.store(true,Ordering::Relaxed);
+        log("DUAL A SUPERGLIDE REPLACED: native ability selected; native glide ended; real aerial finisher queued; release Square to rearm");
+    }
+}
+pub unsafe fn install(){
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    let roll_anchor=[0x81u8,0x0B,0x00,0x00,0x10,0x00];
+    let glide_anchor=[0x83u8,0x88,0x04,0x01,0x00,0x00,0x01];
+    let roll_ok=readable(base+ROLL,0x24) && std::slice::from_raw_parts((base+ROLL+0x16) as *const u8,6)==roll_anchor
+        && rd::<u32>(base+ROLL+0x20)==0x0100_00DC;
+    let glide_ok=readable(base+SUPERGLIDE,0x24) && std::slice::from_raw_parts((base+SUPERGLIDE+0x1D) as *const u8,7)==glide_anchor;
+    if roll_ok{hook::install(base+ROLL,&[0x40,0x53,0x48,0x83,0xEC,0x20],roll as *const () as usize,&ORIG_ROLL,"Dual B committed Dodge Roll");}
+    else{log("DUAL B ROLL HOOK unavailable: native roll anchors differ");}
+    if glide_ok{hook::install(base+SUPERGLIDE,&[0x40,0x53,0x48,0x83,0xEC,0x20,0x48,0x8B,0xD9],superglide as *const () as usize,&ORIG_GLIDE,"Dual A committed Superglide");}
+    else{log("DUAL A FINISHER HOOK unavailable: native Superglide anchors differ");}
+}
