+fn sora_strike_clip(moves:&Moveset,rig:&Rig,battle:&Battle,motion:u16)->Result<Clip,String>{
+    let source=moves.clips.get(&motion).ok_or_else(||format!("Sora motion {motion} clip missing"))?;
+    if !rig.motions.contains_key(&motion) || !(4..=3600).contains(&source.length)
