+//! Endgame playable Riku, not his party AI, NPC, sidecar or a KH1 boss.
+//! OpenKH's object dictionary identifies 2257/P_EH000_LAST and 791/W_EH000.
+//! Native object metadata supplies the actual animation filename, NeoMoveset
+//! and SKLT hand joints. No model, equipment, form state or script is installed.
+//! Sources: https://openkh.dev/kh2/dictionary/obj.html and
+//! https://openkh.dev/kh2/file/type/00objentry.html .
+use crate::{Error, Install, Result, Source, sora::{PlayerSpec, SoraData}};
+
+pub const MODEL:&str="P_EH000_LAST";
+pub const OBJECT:u32=2257;
+pub const WEAPON:&str="W_EH000";
+pub const WEAPON_OBJECT:u32=791;
+
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub struct Profile {
+    pub spec:PlayerSpec,
+    pub declared_motion:String,
+    pub motion_file:String,
+    pub motion_origin:&'static str,
+    pub weapon_joint:u8,
+}
+
+fn motion(declared:&str)->Result<(String,&'static str)>{
+    let name=declared.trim();
+    if name.is_empty(){return Ok((MODEL.into(),"model-name default"));}
+    let name=name.strip_prefix("obj/").or_else(||name.strip_prefix("obj\\")).unwrap_or(name);
+    let name=name.strip_suffix(".mset").unwrap_or(name);
+    if name.is_empty() || !name.bytes().all(|c|c.is_ascii_alphanumeric()||c==b'_'){
+        return Err(Error::Format(format!("playable Riku animation filename invalid: {declared:?}")));
+    }
+    Ok((name.into(),"animation-name override"))
+}
+
+pub fn profile(bytes:&[u8])->Result<Profile>{
+    let objects=kh2_formats::objentry::parse_objentry(bytes)?;
+    let entries:Vec<_>=objects.iter().enumerate().filter(|(_,o)|o.id==OBJECT&&o.model==MODEL).collect();
+    if entries.len()!=1{return Err(Error::Format("final-battle playable Riku object missing or ambiguous".into()));}
+    let (i,o)=entries[0];
+    if o.kind!=0{return Err(Error::Format("final-battle Riku object is not PLAYER".into()));}
+    let (motion_file,motion_origin)=motion(&o.moveset)?;
+    let at=8+i*kh2_formats::objentry::Objentry::SIZE;
+    let moveset=u16::from_le_bytes(bytes[at+0x4e..at+0x50].try_into().unwrap()) as usize;
+    if moveset==0 || moveset>=256{return Err(Error::Format("playable Riku NeoMoveset unavailable".into()));}
+    Ok(Profile{spec:PlayerSpec{model:MODEL,moveset,form:bytes[at+0x57]},declared_motion:o.moveset.clone(),motion_file,motion_origin,weapon_joint:o.weapon_joint})
+}
+
+impl Install {
+    /// The optional second SKLT joint is a free-hand calibration seed only.
+    /// Exactly one real weapon rig is loaded; Single C never duplicates it.
+    pub fn load_playable_riku(&self,source:Source)->Result<(SoraData,Profile,Option<usize>)>{
+        let objects=self.read_any(source,"00objentry.bin")?;
+        let p=profile(&objects)?;
+        let weapon=kh2_formats::objentry::parse_objentry(&objects)?.into_iter()
+            .filter(|o|o.id==WEAPON_OBJECT&&o.model==WEAPON&&o.kind==5).count();
+        if weapon!=1{return Err(Error::Format("playable Riku weapon geometry profile missing or ambiguous".into()));}
+        let requested=format!("obj/{MODEL}.mset");let actual=format!("obj/{}.mset",p.motion_file);
+        let weapon_model=format!("obj/{WEAPON}.mdlx");
+        // The common Sora loader obtains both collision and weapon skeleton from
+        // WEAPON_MDLX. Alias only those reads for this profile, leaving every
+        // existing loader/caller unchanged. WMST still resolves its own motions.
+        let data=crate::sora::load_player_with(source,p.spec,&|name|self.read_any(source,
+            if name==requested{&actual}else if name==crate::sora::WEAPON_MDLX{&weapon_model}else{name}))
+            .map_err(|e|Error::Format(format!("playable Riku resource load: declared={:?} resolved={actual} NeoMoveset={}: {e}",p.declared_motion,p.spec.moveset)))?;
+        let rig=data.rig.as_ref().ok_or_else(||Error::Format(format!("playable Riku rig load: {}",data.rig_error.as_deref().unwrap_or("no rig returned"))))?;
+        if rig.weapons.len()!=1 || !rig.weapons[0].bone.is_some_and(|i|i<rig.skeleton.len()){
+            return Err(Error::Format(format!("playable Riku needs one real weapon track/hand: weapons={} bones={}",rig.weapons.len(),rig.skeleton.len())));
+        }
+        let sklt=kh2_formats::objentry::parse_sklt(&self.read_any(source,"03system.bin")?)?;
+        let hand=sklt.iter().find(|s|s.id==p.weapon_joint as u32).and_then(|s|
+            (s.bones[1]>=0).then_some(s.bones[1] as usize));
+        Ok((data,p,hand))
+    }
+}
