+        .filter_map(|(i,w)|if let WindowKind::Guard{attack,group,weapon}=w.kind{
+            Some(ActiveHitbox{swing:(sample.cast_id<<16)|((sample.spell as u64)<<8)|i as u64,attack,group,weapon})
+        }else{None}).collect::<Vec<_>>();
+    let out=Output{displacement:[0.;3],facing:0.,state:StateName::Magic,motion:193,clip_frame:sample.frame as u32,
+        hitboxes:vec![],invulnerable:false,guarding:!guard_boxes.is_empty(),guard_boxes,
+        weapon_trail:false,locked:None,combo_count:0,combo_live:false,events:vec![]};
+    let mut character=crate::dual_wield::contact_character(&form.character,true);
+    let objects=state.strikes.cast_guard(actor,&out,&anim,&mut character,&form.battle);
+    if objects>0 && NOTES.fetch_add(1,Ordering::Relaxed)<12{
+        super::log(&format!("SINGLE C CAST GUARD ACTIVE: cast={} spell={} motion=193 frame={:.2} native_guard_objects={objects}; no extra damage or invulnerability",sample.cast_id,sample.spell,sample.frame));
+    }
+}
