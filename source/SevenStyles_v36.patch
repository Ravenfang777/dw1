+        return Err(format!("Sora motion {motion} pose/timing/root invalid"));
+    }
+    let mut clip=source.clone();clip.events.clear();
+    clip.windows.retain(|w|match w.kind{
+        WindowKind::Hitbox{attack,group,weapon,..}=>{
+            let (shapes,bones)=match weapon{0=>(&rig.body_shapes,rig.skeleton.len()),
+                1=>match rig.weapons.first(){Some(r)=>(&r.shapes,r.skeleton.len()),None=>return false},_=>return false};
+            w.start<clip.length && w.end.unwrap_or(clip.length).min(clip.length)>w.start
+                && shapes.iter().any(|s|s.kind==6&&s.group==group&&s.bone.is_none_or(|b|b<bones)
+                    && s.radius.is_finite()&&s.radius>0.&&s.radius<=1000.&&s.offset.iter().all(|v|v.is_finite())
