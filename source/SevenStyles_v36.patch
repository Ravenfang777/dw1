+unsafe fn spell_resource(spell:u8)->Option<usize>{
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    let at=base+Rva(0x2D23580)+spell as usize*0x38;
+    if !readable(at,0x38){return None;}
+    let level=rd::<i32>(at);if !(1..=3).contains(&level)
+        || !crate::dual_wield::native_spell_draw_hidden(dual::style(),spell,level as u8,dual_magic_fx::package_ready(spell,level as u8),true){return None;}
+    let file=rd::<u64>(at+8) as usize;if !readable(file,12){return None;}
+    let offset=rd::<u32>(file+8) as usize;if !(12..=0x400_0000).contains(&offset){return None;}
+    let resource=file.checked_add(offset)?;
+    (readable(resource,16) && (1..=4096).contains(&rd::<u32>(resource+12))).then_some(resource)
+}
+unsafe fn which_resource(resource:usize)->Option<u8>{(0..4).find(|s|spell_resource(*s)==Some(resource))}
+fn within<T>(context:Context,run:impl FnOnce()->T)->T{
+    struct Restore(Option<Context>);
+    impl Drop for Restore{fn drop(&mut self){CONTEXT.with(|c|c.set(self.0));}}
+    let old=CONTEXT.with(|c|c.replace(Some(context)));let _restore=Restore(old);run()
+}
+/// The native command has already selected its caster and spell; failed casts make no
+/// spell effects to tag. Other resources and all companion casts retain their rendering.
+pub unsafe fn with_spell<T>(actor:usize,spell:u8,run:impl FnOnce()->T)->T{
+    if let Some(binding)=scope().filter(|b|b.actor==actor){
+        if spell<4 && spell_resource(spell).is_some(){return within(Context{binding,spell,cast_id:super::takeover::GAME_FRAME.load(Ordering::Relaxed),child:false},run);}
+    }run()
+}
+pub unsafe fn with_actor<T>(actor:usize,run:impl FnOnce()->T)->T{
+    if let Some(b)=scope().filter(|b|b.actor==actor){
+        if let Some(s)=super::dual_cast::sample(actor,b.instance).filter(|s|s.spell<4){
+            return within(Context{binding:b,spell:s.spell,cast_id:s.cast_id,child:false},run);
+        }
+    }run()
+}
+unsafe fn object(record:usize)->Option<usize>{
+    if !readable(record,0x3c)||rd::<u32>(record+0x14)&3!=1{return None;}
+    let p=pose::ptr(rd::<u32>(record));readable(p,0xe0).then_some(p)
+}
+unsafe fn remember(record:usize,context:Context){
+    let Some(p)=object(record) else{return;};
+    if let Ok(mut tags)=TAGS.try_lock(){
+        tags.retain(|_,t|t.binding==context.binding);
+        if tags.len()>=1024{tags.clear();}
+        tags.insert(p,Tag{binding:context.binding,sequence:rd::<u32>(p+0xcc),spell:context.spell,cast_id:context.cast_id});
+    }
+}
+unsafe extern "system" fn create(resource:usize,record:usize,id:i32,priority:i32)->i32{
+    let f:unsafe extern "system" fn(usize,usize,i32,i32)->i32=std::mem::transmute(ORIGINAL_CREATE.load(Ordering::Acquire));
+    let result=f(resource,record,id,priority);
+    if result!=0{if let (Some(c),Some(b))=(CONTEXT.with(Cell::get),scope()){
+        if c.binding==b && (c.child||spell_resource(c.spell)==Some(resource)){remember(record,c);}
+    }}result
+}
+unsafe extern "system" fn step(effect:usize,draw:i32)->i32{
+    let f:unsafe extern "system" fn(usize,i32)->i32=std::mem::transmute(ORIGINAL_STEP.load(Ordering::Acquire));
+    let Some(b)=scope() else{return f(effect,draw);};
+    if !readable(effect,0xe0){return f(effect,draw);}
+    let sequence=rd::<u32>(effect+0xcc);
+    let tagged=TAGS.try_lock().ok().and_then(|tags|tags.get(&effect).copied())
+        .filter(|t|t.binding==b && t.sequence==sequence);
+    let record=rd::<u64>(effect+0xb0) as usize;
+    let spell=tagged.map(|t|(t.spell,t.cast_id)).or_else(||{
+        if object(record)!=Some(effect){return None;}
+        let owner=pose::ptr(rd::<u32>(record+0x18));
+        if !readable(owner,8)||rd::<u64>(owner) as usize!=b.actor{return None;}
+        let spell=which_resource(pose::ptr(rd::<u32>(record+0x38)))?;
+        let cast=super::dual_cast::sample(b.actor,b.instance).filter(|s|s.spell==spell)?;
+        Some((spell,cast.cast_id))
+    });
+    let Some((spell,cast_id))=spell else{return f(effect,draw);};
+    if !dual_magic_fx::native_visual_admitted(b,spell,cast_id){return f(effect,draw);}
+    let c=Context{binding:b,spell,cast_id,child:true};remember(record,c);
+    if draw!=0 && NOTES.fetch_add(1,Ordering::Relaxed)<24{
+        log(&format!("DUAL B NATIVE SPELL DRAW FILTERED: spell={spell}; owned native effect; VM simulation/audio/damage continue; KH2 package ready"));
+    }
+    within(c,||f(effect,0))
+}
+pub unsafe fn install(){
+    if Build::current()!=Build::Steam{log("Native spell draw filter unavailable for this build; native visuals retained");return;}
+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;
+    let create_ok=hook::install(base+CREATE_STEAM,&[0x48,0x89,0x5c,0x24,0x10],create as *const () as usize,&ORIGINAL_CREATE,"native spell visual ownership").is_some();
+    let step_ok=hook::install(base+STEP_STEAM,&[0x48,0x89,0x5c,0x24,0x18],step as *const () as usize,&ORIGINAL_STEP,"native spell rendering only").is_some();
+    READY.store(create_ok&&step_ok,Ordering::Release);
+    log(&format!("DUAL B NATIVE SPELL DRAW FILTER READY={}; four matching spells only, owned effects/children; native no-draw VM path, no HP/MP or spell-state writes",create_ok&&step_ok));
+}
