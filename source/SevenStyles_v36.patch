+
+pub fn can_request(state: i32, slot: Option<usize>, owned: bool) -> bool {
+    if owned { return matches!(state, 0..=2) && matches!(slot, Some(0..=13)); }
+    match state {
+        0 => matches!(slot, Some(0..=7)),
+        1 | 2 => matches!(slot, Some(8..=13)),
+        _ => false,
+    }
+}
+
+pub fn idle_slot(state: i32, slot: Option<usize>) -> bool {
+    state == 0 && matches!(slot, Some(0 | 1))
+}
+
+/// Custom poses use the pass's axes and the live actor's translation. Never derive a new
+/// placement from the bone array we previously overwrote, or reuse an old room's position.
+pub fn anchored_placement(mut pass: glam::Mat4, actor: [f32; 3]) -> Option<glam::Mat4> {
+    if !pass.is_finite() || !actor.iter().all(|v| v.is_finite())
+        || pass.x_axis.w.abs() > 1e-4 || pass.y_axis.w.abs() > 1e-4
+        || pass.z_axis.w.abs() > 1e-4 || pass.determinant().abs() < 1e-5 { return None; }
+    pass.w_axis = glam::Vec3::from(actor).extend(1.0);
+    Some(pass)
+}
+
+/// Both native and imported sources publish world-space weapon bones in one transaction.
+/// Keeping a separate placement let v1 combine old world-space bones with a new placement.
+#[derive(Clone)]
+pub struct WeaponPose {
+    pub bones: [glam::Mat4; 13],
+    pub binding: Binding,
+    pub frame: u64,
+}
+
+impl WeaponPose {
+    pub fn new(local: [glam::Mat4; 13], placement: glam::Mat4, hand: glam::Mat4,
+        binding: Binding, frame: u64) -> Option<Self> {
+        let bones = local.map(|m| placement * m);
+        let hand = (placement * hand).w_axis.truncate();
+        let grip = bones[0].w_axis.truncate();
+        if !hand.is_finite() || !bones.iter().all(|m| m.is_finite()
+            && (m.w_axis.truncate() - grip).length() <= 300.0)
+            || (grip - hand).length() > 50.0 { return None; }
+        Some(Self { bones, binding, frame })
+    }
+
+    pub fn current(&self, binding: Binding, frame: u64) -> bool {
+        self.binding == binding && frame >= self.frame && frame - self.frame <= 1
+    }
+}
