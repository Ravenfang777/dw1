+    // Reorder whole branches, remove unmeasured wardrobe and insert wrappers.
+    // The production map sees only these bones and the two actual hand anchors.
+    fn reordered(a:&[Bone], scale:f32) -> (Vec<Bone>,Vec<usize>,Vec<usize>) {
+        let world=positions(&kh2_anim::Pose::bind(a).bones);
+        let mut keep=vec![false;a.len()];
+        for i in layout().0.iter().flat_map(source_points).chain([86,178]) {
+            let mut at=i;
+            loop {keep[at]=true; if a[at].parent<0{break;} at=a[at].parent as usize;}
+        }
+        let mut kids=vec![Vec::new();a.len()];
+        for i in 1..a.len(){if keep[i]{kids[a[i].parent as usize].push(i);}}
+        let mut out=Vec::new();let mut map=vec![usize::MAX;a.len()];let mut origin=Vec::new();
+        fn visit(i:usize,parent:i16,a:&[Bone],world:&[Vec3],kids:&[Vec<usize>],out:&mut Vec<Bone>,map:&mut [usize],origin:&mut Vec<usize>,scale:f32){
+            let mut parent=parent;
+            if [12,76,137,171,185].contains(&i){
+                let p=a[i].parent as usize;
+                let pos=world[p]*scale;
+                let base=if parent<0{Vec3::ZERO}else{world[origin[parent as usize]]*scale};
+                let index=out.len() as i16;
+                out.push(Bone{index,parent,sibling:-1,child:-1,flags:0,scale:[1.;3],length:0.,rotation:[0.;3],translation:(pos-base).to_array()});
+                origin.push(p);parent=index;
+            }
+            let base=if parent<0{Vec3::ZERO}else{world[origin[parent as usize]]*scale};
+            let index=out.len() as i16;map[i]=index as usize;
+            out.push(Bone{index,parent,sibling:-1,child:-1,flags:0,scale:[1.;3],length:0.,rotation:[0.;3],translation:(world[i]*scale-base).to_array()});
+            origin.push(i);
+            for &c in kids[i].iter().rev(){visit(c,index,a,world,kids,out,map,origin,scale);}
+        }
+        visit(0,-1,a,&world,&kids,&mut out,&mut map,&mut origin,scale);
+        (out,map,origin)
+    }
+
+    fn remove(a:&[Bone],drop:&[usize])->(Vec<Bone>,Vec<usize>){
+        let bind=kh2_anim::Pose::bind(a).bones;let mut out=Vec::new();let mut map=vec![usize::MAX;a.len()];
+        for i in 0..a.len(){
+            if drop.contains(&i){continue;}
+            let mut parent=a[i].parent;
+            while parent>=0 && drop.contains(&(parent as usize)){parent=a[parent as usize].parent;}
+            let local=if parent<0{bind[i]}else{bind[parent as usize].inverse()*bind[i]};
+            let (scale,rotation,translation)=local.to_scale_rotation_translation();
+            let (x,y,z)=rotation.to_euler(glam::EulerRot::XYZ);
+            let index=out.len() as i16;map[i]=index as usize;
+            out.push(Bone{index,parent:if parent<0{-1}else{map[parent as usize] as i16},sibling:-1,child:-1,flags:0,
+                scale:scale.to_array(),rotation:[x,y,z],translation:translation.to_array(),length:0.});
+        }
+        (out,map)
+    }
