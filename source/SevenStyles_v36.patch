+//! Playable prologue dual Roxas, resolved from the user's own object table.
+//! Object 803 / P_EX110_BTLF is documented by OpenKH's object dictionary.
+//! Never substitute the boss, NPC, single-weapon Roxas or Valor's combo table.
+//! Sources: https://openkh.dev/kh2/dictionary/obj.html and
+//! https://openkh.dev/kh2/file/type/00objentry.html (layout, player type, native form metadata).
+use crate::{Error, Install, Result, Source, sora::{PlayerSpec, SoraData}};
+
+pub const MODEL: &str = "P_EX110_BTLF";
+pub const OBJECT: u32 = 803;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Profile {
+    pub spec: PlayerSpec,
+    pub motion_file: String,
+}
+
+/// NeoMoveset at object entry +4E indexes PTYA, pref and wmst. Resolve it,
+/// together with the real motion filename, rather than guessing a table id.
+pub fn profile(bytes: &[u8]) -> Result<Profile> {
+    let objects = kh2_formats::objentry::parse_objentry(bytes)?;
+    let matches: Vec<_> = objects.iter().enumerate()
+        .filter(|(_, o)| o.id == OBJECT && o.model == MODEL).collect();
+    if matches.len() != 1 { return Err(Error::Format("playable dual Roxas object missing or ambiguous".into())); }
+    let (index, object) = matches[0];
+    if object.kind != 0 { return Err(Error::Format("dual Roxas object is not a player".into())); }
+    if object.moveset.is_empty() || !object.moveset.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_') {
+        return Err(Error::Format("dual Roxas motion filename invalid".into()));
+    }
+    let at = 8 + index * kh2_formats::objentry::Objentry::SIZE + 0x4e;
+    let id = u16::from_le_bytes(bytes[at..at+2].try_into().unwrap()) as usize;
+    if id == 0 || id >= 256 { return Err(Error::Format("dual Roxas NeoMoveset unavailable".into())); }
+    // This is metadata only. Loading the donor never enters this native form.
+    Ok(Profile { spec: PlayerSpec { model: MODEL, moveset: id, form: bytes[8 + index * 0x60 + 0x57] }, motion_file: object.moveset.clone() })
+}
+
+impl Install {
+    pub fn dual_roxas_profile(&self, source: Source) -> Result<Profile> {
+        profile(&self.read_any(source, "00objentry.bin")?)
+    }
+
+    pub fn load_dual_roxas(&self, source: Source) -> Result<(SoraData, Profile)> {
+        let p = self.dual_roxas_profile(source)?;
+        let requested = format!("obj/{MODEL}.mset");
+        let actual = format!("obj/{}.mset", p.motion_file);
+        let data = crate::sora::load_player_with(source, p.spec, &|name|
+            self.read_any(source, if name == requested { &actual } else { name }))?;
+        if !data.rig.as_ref().is_some_and(|r| r.weapons.len() == 2
+            && r.weapons.iter().all(|w| w.bone.is_some_and(|b| b < r.skeleton.len()))) {
+            return Err(Error::Format("playable dual Roxas needs two real weapon tracks and attachment joints".into()));
+        }
+        Ok((data, p))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn entry(id:u32,model:&str,motion:&str,moveset:u16)->Vec<u8>{
+        let mut b=vec![0;8+0x60];b[4..8].copy_from_slice(&1u32.to_le_bytes());
+        b[8..12].copy_from_slice(&id.to_le_bytes());
+        b[16..16+model.len()].copy_from_slice(model.as_bytes());
+        b[48..48+motion.len()].copy_from_slice(motion.as_bytes());
+        b[8+0x4e..8+0x50].copy_from_slice(&moveset.to_le_bytes());b[8+0x57]=10;b
+    }
+    #[test] fn dual_roxas_uses_object_moveset_and_motion_name_instead_of_valor_defaults(){
+        for id in [7,19,0x44]{let p=profile(&entry(803,MODEL,"P_EX110_BTLF",id)).unwrap();
+            assert_eq!(p.spec.moveset,id as usize);assert_eq!(p.spec.model,MODEL);assert_eq!(p.spec.form,10);
+            assert_eq!(p.motion_file,"P_EX110_BTLF");}
+        assert_eq!(profile(&entry(803,MODEL,"P_EX110_SHARED",19)).unwrap().motion_file,"P_EX110_SHARED");
+    }
+    #[test] fn dual_roxas_rejects_boss_single_npc_bad_tables_and_motion_paths(){
+        for (id,model) in [(2385,"B_EX390"),(90,"P_EX110"),(2358,"N_EX820_BTL"),(85,"P_EX100_BTLF")]{
+            assert!(profile(&entry(id,model,model,19)).is_err());}
+        for motion in ["","../P_EX110","obj/P_EX110"]{assert!(profile(&entry(803,MODEL,motion,19)).is_err());}
+        for id in [0,256,u16::MAX]{assert!(profile(&entry(803,MODEL,MODEL,id)).is_err());}
+        assert!(profile(&[0;5]).is_err());
+        let mut boss=entry(803,MODEL,MODEL,19);boss[8+4]=3;assert!(profile(&boss).is_err());
+        let mut b=entry(803,MODEL,MODEL,19);b[4..8].copy_from_slice(&2u32.to_le_bytes());assert!(profile(&b).is_err());
+        let e=entry(803,MODEL,MODEL,19);let mut b=e.clone();b.extend_from_slice(&e[8..]);b[4..8].copy_from_slice(&2u32.to_le_bytes());
+        assert!(profile(&b).is_err());
+    }
+}
