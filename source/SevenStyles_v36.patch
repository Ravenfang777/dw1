+pub fn hand_basis(kh1_bind: glam::Mat4, kh2_bind: glam::Mat4) -> Option<glam::Mat4> {
+    let mut a=kh1_bind; let mut b=kh2_bind;
+    a.w_axis=glam::Vec4::W; b.w_axis=glam::Vec4::W;
