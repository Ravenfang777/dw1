+pub fn source_diagnostic(moves:&Moveset,rig:&Rig,battle:&Battle,motion:u16)->String{
+    let Some(c)=moves.clips.get(&motion)else{return format!("motion={motion} clip_missing");};
+    let hits=c.windows.iter().filter_map(|w|if let WindowKind::Hitbox{attack,group,weapon,..}=w.kind{
+        let a=battle.attack_for_level(attack,0,0);
+        let shapes=match weapon{0=>rig.body_shapes.iter().filter(|s|s.kind==6&&s.group==group).count(),
+            1=>rig.weapons.first().map_or(0,|r|r.shapes.iter().filter(|s|s.kind==6&&s.group==group).count()),_=>0};
+        Some(format!("w{weapon}/g{group}/a{attack}/shapes{shapes}/kind{:?}/stat{:?}/power{:?}",a.map(|a|a.kind),a.map(|a|a.stat_source),a.map(|a|a.power)))
+    }else{None}).take(12).collect::<Vec<_>>().join("+");
+    format!("motion={motion} pose={} frames={} root_samples={} hits=[{hits}]",rig.motions.contains_key(&motion),c.length,c.root.len())
