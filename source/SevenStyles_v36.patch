+pub fn single_character(template:&character_core::Character,wisdom:bool)->Option<character_core::Character>{
+    use character_core::WindowKind;
+    let mut moves=template.moveset.clone();retain_base(&mut moves.combo_rows);
+    moves.combo_rows.retain(|r|r.kind==3 && r.id!=GUARD_ROW && moves.clips.get(&r.motion).is_some_and(|c|
+        if wisdom{c.events.iter().any(|e|matches!(e.kind,character_core::EventKind::Effect(_)))}
+        else{c.windows.iter().any(|w|matches!(w.kind,WindowKind::Hitbox{weapon:1,..}))}));
+    fix_subs(&mut moves.combo_rows);
+    if ![false,true].iter().all(|air|moves.combo_rows.iter().any(|r|r.is_air()==*air)){return None;}
+    for c in moves.clips.values_mut(){
+        c.events.retain(|e|wisdom && matches!(e.kind,character_core::EventKind::Effect(_)));
+        c.windows.retain(|w|!matches!(w.kind,WindowKind::Hitbox{weapon:0|2,..}|WindowKind::Guard{..}
+            |WindowKind::Invulnerable|WindowKind::OfferCommand(_)|WindowKind::ScriptRange(_)));
+    }
+    let mut ch=character_core::Character::new(moves,template.params.clone(),vec![],template.attack.clone());
+    ch.reaction=template.reaction.clone();ch.abilities=abilities(&[]);
+    if wisdom{ch.set_combo_on_miss(true);}Some(ch)
+}
