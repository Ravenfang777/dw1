+        for e in rt.magic.update(&mut world).into_iter().chain(rt.magic.take_events()){
+            if let kh2_magic::Event::Error(e)=e{note(format!("DUAL B visual script: {e}"));}
+        }
+        let mut seen=vec![];
+        for e in &rt.magic.effects{
+            seen.push(e.id);let Some(index)=rt.packages.iter().position(|p|p.as_ref().is_some_and(|p|p.file==e.spell)) else{continue;};
+            let Some(p)=rt.packages[index].as_mut() else{continue;};
+            match rt.handles.get(&e.id).copied(){
+                None=>if e.alive(){if let Some(h)=p.fx.start(e.element.id,&mut |c|world.game_bone(c)){
+                    if e.owner!=Some(SORA){p.fx.set_anchor(h,place(e.pos,e.dir));}
+                    rt.handles.insert(e.id,(index,h,false));
+                }},
+                Some((_,h,ended))=>{
+                    if e.owner!=Some(SORA){p.fx.set_anchor(h,place(e.pos,e.dir));}
+                    if e.killed{p.fx.kill(h);}else if e.fade.is_some(){p.fx.set_alpha(h,e.alpha());if !e.alive(){p.fx.kill(h);}}
+                    else if (e.ended_at.is_some()||!e.alive())&&!ended{p.fx.end(h);rt.handles.insert(e.id,(index,h,true));}
+                }
+            }
+        }
+        rt.handles.retain(|id,(index,h,_)|seen.contains(id)||rt.packages[*index].as_ref().is_some_and(|p|p.fx.is_running(*h)));
