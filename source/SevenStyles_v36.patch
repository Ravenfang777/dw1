+/// Admission for an indexed humanoid donor with its own hierarchy/bind pose.
+/// The position-based retarget never requires source parents to equal Sora's.
+#[derive(Clone, Copy, Debug)]
+pub struct SourceGeometry {
+    pub landmarks: usize,
+    pub core_parts: usize,
+    pub parent_differences: usize,
+    pub max_normalized_error: f32,
+}
+
+fn core_source_part(part: &Part) -> bool {
+    match *part {
+        Part::Torso { .. } => true,
+        Part::Aim { from, .. } => [PLUS_X, minus_x()].iter().any(|s|
+            [s.hip,s.knee,s.heel,s.clavicle,s.shoulder,s.elbow,s.wrist].contains(&from)),
+    }
+}
+
+fn source_points(part: &Part) -> Vec<usize> {
+    match *part {
+        Part::Torso { right, up } => vec![right.0,right.1,up.0,up.1],
+        Part::Aim { from,to,pole } => {
+            let mut points=vec![from,to];
+            match pole {
+                Pole::Line(a,b) => points.extend([a,b]),
+                Pole::Joint { a,b,c,fallback,.. } => points.extend([a,b,c,fallback.0,fallback.1]),
+                Pole::Knee { a,b,c,hips } => points.extend([a,b,c,hips.0,hips.1]),
+                Pole::Foot { ankle,.. } => points.push(ankle),
+            }
+            points
+        }
+    }
+}
+
+/// Validate the landmarks the existing retarget measures, using each model's
+/// own FK. Source parent indices and optional wardrobe bones may differ.
+/// The 0.35 leg-height bound allows proportions while rejecting wrong indices.
+pub fn validate_source_geometry(reference:&[Bone],candidate:&[Bone])->Result<SourceGeometry,String>{
+    let (parts,_,_)=layout();
+    let mut needed=vec![0,13,42];
+    for part in parts.iter().filter(|p|core_source_part(p)){needed.extend(source_points(part));}
+    needed.sort_unstable();needed.dedup();
+    for &i in &needed{
+        for (name,bones) in [("reference",reference),("donor",candidate)]{
+            let b=bones.get(i).ok_or_else(||format!("{name} missing source landmark {i}"))?;
+            if b.index as usize!=i || b.parent>=0 && b.parent as usize>=i
+                || !b.scale.iter().chain(&b.rotation).chain(&b.translation).all(|x|x.is_finite()){
+                return Err(format!("{name} invalid source landmark {i}"));
+            }
+        }
+    }
+    let a=kh2_anim::Pose::bind(reference).bones;let b=kh2_anim::Pose::bind(candidate).bones;
+    let (pa,pb)=(positions(&a),positions(&b));
+    let height=|p:&[Vec3]|p[0].y-(p[13].y+p[42].y)*0.5;
+    let (ha,hb)=(height(&pa),height(&pb));
+    if !ha.is_finite() || !hb.is_finite() || ha<1.0 || hb<1.0 || !(0.5..=2.0).contains(&(hb/ha)){
+        return Err(format!("donor leg-height scale invalid: reference={ha:.3} donor={hb:.3}"));
+    }
+    let mut max_error=0.0f32;
+    for &i in &needed{
+        if !a[i].is_finite() || !b[i].is_finite() || a[i].determinant().abs()<1e-6 || b[i].determinant().abs()<1e-6{
+            return Err(format!("nonfinite/singular source bind landmark {i}"));
+        }
+        let da=(pa[i]-pa[0])/ha;let db=(pb[i]-pb[0])/hb;
+        let distance=(da-db).length();
+        if !distance.is_finite() || distance>0.35{
+            return Err(format!("source landmark {i} geometry differs: normalized_error={distance:.4} reference={da:.3?} donor={db:.3?}"));
+        }
+        max_error=max_error.max(distance);
+    }
+    let candidate_frames=frames(&parts,&pb);
+    let mut core_parts=0;
+    for (i,part) in parts.iter().enumerate().filter(|(_,p)|core_source_part(p)){
+        if candidate_frames[i].is_none(){return Err(format!("donor source body part {i} is degenerate: landmarks={:?}",source_points(part)));}
+        core_parts+=1;
+    }
+    Ok(SourceGeometry{landmarks:needed.len(),core_parts,
+        parent_differences:needed.iter().filter(|&&i|reference[i].parent!=candidate[i].parent).count(),
+        max_normalized_error:max_error})
+}
