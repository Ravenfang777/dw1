+    let base=super::sys::GetModuleHandleA(std::ptr::null()) as usize;BASE.store(base,Ordering::Relaxed);
+    if hook::install(base+WORLD_PASS,&[0x48,0x8B,0xC4,0x48,0x89,0x58,0x08,0x48,0x89,0x70,0x10,0x48,0x89,0x78,0x18],world_pass as *const () as usize,&ORIG,"Dual B KH2 spell effect pass").is_none(){return;}
