+pub fn standard_glide_template(world:&[glam::Mat4],bind:&[glam::Mat4],binding:Binding,
+    frame:u64,actor:[f32;3])->Option<NativeAttachment>{
+    use glam::{Mat4,Vec3};
+    if world.len()<293 || bind.len()<293 || !actor.iter().all(|v|v.is_finite()){return None;}
+    let left=world[GLIDE_PALM];let right=world[RIGHT_PALM];let blade=world[282];
+    for m in [left,right,blade]{
