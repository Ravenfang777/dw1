+/// An explicitly requested source action may contain script/FX events; those
+/// never run here. Retain only real physical contacts on the admitted rig.
+fn explicit_clip(moves:&Moveset,rig:&Rig,battle:&Battle,motion:u16,body_contacts:bool)->Result<Clip,String>{
+    let source=moves.clips.get(&motion).ok_or_else(||format!("Riku motion {motion} clip missing"))?;
+    if !rig.motions.contains_key(&motion) || !(4..=3600).contains(&source.length)
+        || source.root.len()<source.length as usize+1 || source.root.iter().flatten().any(|v|!v.is_finite()){
+        return Err(format!("Riku motion {motion} pose/timing/root invalid"));
+    }
+    let mut clip=source.clone();clip.events.clear();
+    clip.windows.retain(|w|match w.kind{
+        WindowKind::Hitbox{attack,group,weapon:0,..} if body_contacts=>{
+            w.start<clip.length && w.end.unwrap_or(clip.length).min(clip.length)>w.start
+                && rig.body_shapes.iter().any(|s|s.kind==6 && s.group==group && s.bone.is_none_or(|b|b<rig.skeleton.len()))
+                && battle.attack_for_level(attack,0,99).is_some_and(|a|matches!(a.kind,0|1)&&a.stat_source==0&&a.power>0&&a.attack_kind_flags&4==0)
+        },
+        WindowKind::Hitbox{..}=>physical(rig,&[],battle,w,source.length),
+        WindowKind::NoGravity|WindowKind::WeaponTrail=>true,
+        _=>false,
+    });
+    Ok(clip)
+}
+
+/// User-selected aerial source: every press-counted air combo step uses the
+/// full 181 sequence. Ground aliases, source data and Combo Plus stay intact.
+pub fn refine_air_combos(out:&mut PreparedCombos,moves:&Moveset,rig:&Rig,battle:&Battle)->Result<(),String>{
+    let mut source=explicit_clip(moves,rig,battle,181,false)?;
+    let hits:Vec<_>=source.windows.iter().filter(|w|matches!(w.kind,WindowKind::Hitbox{..})).copied().collect();
+    if hits.is_empty(){return Err("Riku aerial sequence 181 has no admitted physical weapon contacts".into());}
+    if !source.windows.iter().any(|w|matches!(w.kind,WindowKind::WeaponTrail)){
+        source.windows.extend(hits.iter().map(|w|Window{start:w.start,end:w.end,kind:WindowKind::WeaponTrail}));
+    }
+    source.windows.push(Window{start:0,end:Some(source.length),kind:WindowKind::NoGravity});
+    let followup=hits.iter().map(|w|w.end.unwrap_or(source.length).min(source.length)).max().unwrap().min(source.length-1);
+    for link in out.bindings.iter_mut().filter(|b|b.air){
+        let mut clip=source.clone();clip.motion=link.host;
+        if !link.finisher{clip.windows.push(Window{start:followup,end:Some(clip.length),kind:WindowKind::Combo});}
+        out.moveset.clips.insert(link.host,clip);
+        out.rig.motions.insert(link.host,rig.motions[&181].clone());
+        for (dst,src) in out.rig.weapons.iter_mut().zip(&rig.weapons){
+            if let Some(p)=src.motions.get(&181).or_else(||src.motions.get(&0)){dst.motions.insert(link.host,p.clone());}
+        }
+        link.source=181;link.followup=followup;
+    }
+    out.shared_air=false;Ok(())
+}
+
+/// One explicitly requested airborne Square action. Its own real body group is
+/// allowed only on 193, never on the ordinary weapon combo. No script or chain.
+pub fn prepare_air_action(moves:&Moveset,rig:&Rig,battle:&Battle)->Result<Clip,String>{
+    explicit_clip(moves,rig,battle,193,true)
+}
