+            let lib=Library::load(&bytes,Some(&common)).map_err(|e|format!("{e:?}"))?;
+            log(&format!("DUAL B KH2 EFFECT PACKAGE: spell={spell} level={level} elements={} textures={} parser_warnings={}",lib.elements().len(),lib.textures().len(),lib.warnings().len()));
+            let tex=textures.len() as u32;textures.extend(lib.textures().iter().map(|t|(t.width,t.height,t.rgba.clone())));
