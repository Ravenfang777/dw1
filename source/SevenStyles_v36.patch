+pub fn exclusive_style(list:&mut [u8;SLOTS],previous:Style)->Style{
+    let both=list.iter().take_while(|b|**b!=0).any(|b|*b==ID)
+        && list.iter().take_while(|b|**b!=0).any(|b|*b==RANGED_ID);
