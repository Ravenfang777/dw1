+unsafe extern "system" fn neutral_native(_:usize,dir:usize){
+    let b=BASE.load(Ordering::Relaxed);assert_eq!(read::<[f32;4]>(dir),[0.;4]);assert_eq!(read::<u32>(b+0x298d4a0+4)&crate::overdrive_activation::CONTROL_BITS,0);
+    assert_ne!(read::<u32>(b+0x298d4a0+4)&0x8000,0);assert_eq!(read::<u32>(b+0x2d54440)&0x04000000,0);
+    write(b+0x298d4a0+4,read::<u32>(b+0x298d4a0+4)|0x400);
+}
+#[test]fn native_control_keeps_system_input_and_restores_only_masked_bits_without_actor_writes(){let _lock=TEST.lock().unwrap();unsafe{
+    let h=Host::new();let b=h.base();let top=b+0x529600;actual::test_context();write(b+0x298d4a0+8,crate::overdrive_activation::TRIANGLE);actual::menu_entry(top,3);
+    let before=h.actor.clone();write(b+0x298d4a0+4,crate::overdrive_activation::CONTROL_BITS|0x8000);write(b+0x2d54440,0x04000000u32);
+    assert!(actual::control(h.actor(),neutral_native as *const ()as usize));assert_eq!(h.actor,before);
+    assert_eq!(read::<u32>(b+0x298d4a0+4),crate::overdrive_activation::CONTROL_BITS|0x8400);assert_eq!(read::<u32>(b+0x2d54440),0x04000000);
+    SLOT.store(56,Ordering::Relaxed);actual::frame(h.actor());assert!(!actual::busy());assert_eq!(actual::active_choice(),0);
+}}
