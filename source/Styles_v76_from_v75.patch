@@ -0,0 +1,102 @@
+//! Overdrive selection arms an activation; only a completed, witnessed one enables its aura.
+use crate::dual_wield::Binding;
+use glam::{Mat4,Vec3};
+pub const MOTION:u16=52;
+pub const RECORD:u8=0x87;
+pub const WORD:u16=0x1f5;
+pub const TRIANGLE:u32=0x0400_0000;
+pub const CONTROL_BITS:u32=0x04b5_001f; // actions/shortcut; pause/system controls are outside it.
+pub const COMMAND_RECORD:[u8;16]=[0x10,0,0xff,0,WORD as u8,(WORD>>8)as u8,99,0,0,0xff,1,2,0,0,0,0];
+
+#[derive(Clone,Copy,Debug)]
+pub struct View{pub binding:Binding,pub choice:u32,pub serial:u64,pub frame:f32,pub length:f32}
+#[derive(Clone,Copy,Debug)]
+struct Animation{frame:f32,length:f32,witness:f32,wait:f32}
+#[derive(Default,Debug)]
+pub struct Activation{
+    choice:u32,binding:Option<Binding>,active:bool,animation:Option<Animation>,serial:u64,latched:bool,
+}
+impl Activation{
+    pub const fn new()->Self{Self{choice:0,binding:None,active:false,animation:None,serial:0,latched:false}}
+    pub fn sync(&mut self,choice:u32,binding:Option<Binding>){
+        let choice=if choice<=crate::overdrive::COUNT as u32{choice}else{0};
+        let owner_changed=match(self.binding,binding){(Some(a),Some(b))=>a.actor!=b.actor||a.instance!=b.instance,(None,None)=>false,_=>true};
+        if self.choice!=choice||owner_changed||binding.is_none(){self.active=false;self.animation=None;}
+        else if self.binding!=binding&&self.animation.is_some(){self.active=false;self.animation=None;}
+        self.choice=choice;self.binding=binding;
+    }
+    pub fn begin(&mut self,fresh:bool,eligible:bool,length:f32)->bool{
+        if !fresh||self.latched||!eligible||self.choice==0||self.binding.is_none()||self.animation.is_some()
+            ||!length.is_finite()||!(1.0..=600.0).contains(&length){return false;}
+        self.latched=true;self.active=false;self.serial=self.serial.wrapping_add(1).max(1);
+        self.animation=Some(Animation{frame:0.,length,witness:-1.,wait:0.});true
+    }
+    pub fn advance(&mut self,dt:f32,held:bool,valid:bool,paused:bool){
+        if !held{self.latched=false;}
+        if !valid{self.active=false;self.animation=None;return;}
+        if paused{return;}
+        let Some(a)=self.animation.as_mut()else{return;};
+        if a.frame>=a.length&&a.witness>=a.length{self.animation=None;self.active=true;return;}
+        if !dt.is_finite()||dt<=0.{return;}
+        let dt=dt.min(8.);
+        if a.frame>=a.length{a.wait+=dt;if a.wait>=120.{self.animation=None;self.active=false;}}
+        else{a.frame=(a.frame+dt).min(a.length);}
+    }
+    pub fn witness(&mut self,view:View){
+        if self.binding!=Some(view.binding)||self.choice!=view.choice||self.serial!=view.serial{return;}
+        if let Some(a)=self.animation.as_mut(){if view.frame.is_finite()&&view.frame<=a.frame{a.witness=a.witness.max(view.frame);}}
+    }
+    pub fn view(&self)->Option<View>{let a=self.animation?;Some(View{binding:self.binding?,choice:self.choice,serial:self.serial,frame:a.frame,length:a.length})}
+    pub fn aura(&self)->u32{if self.active&&self.animation.is_none(){self.choice}else{0}}
+    pub fn busy(&self)->bool{self.animation.is_some()}
+}
+pub fn free_slot(state:i32,slot:Option<usize>)->bool{
+    matches!(crate::dual_wield::native_visual(state,slot),Some(
+        crate::dual_wield::Visual::Idle|crate::dual_wield::Visual::Walk|crate::dual_wield::Visual::Run|
+        crate::dual_wield::Visual::Jump|crate::dual_wield::Visual::Fall|crate::dual_wield::Visual::Land))
+}
+/// The source elements are authored at a hand/tip. Cancel that translation so
+/// both effect roots share the live body center, retaining their rotations/scales.
+pub fn centered_anchor(world:Mat4,position:[f32;3],offset:[f32;3])->Option<Mat4>{
+    if !world.is_finite()||!position.iter().chain(offset.iter()).all(|v|v.is_finite()){return None;}
+    let mut center=world;center.w_axis=Vec3::new(position[0],position[1]-70.,position[2]).extend(1.);
+    let anchor=center*Mat4::from_translation(-Vec3::from(offset));anchor.is_finite().then_some(anchor)
+}
+
+#[cfg(test)]mod tests{
+    use super::*;
+    fn binding()->Binding{Binding{actor:1,instance:2,matrices:3,weapon:4,generation:1}}
+    #[test]fn selection_does_not_enable_aura_and_full_pose_witness_is_required(){
+        let mut a=Activation::default();a.sync(6,Some(binding()));assert_eq!(a.aura(),0);assert!(a.begin(true,true,160.));
+        for _ in 0..160{a.advance(1.,true,true,false);assert_eq!(a.aura(),0);}
+        a.advance(1.,true,true,false);assert!(a.busy());let mut stale=a.view().unwrap();stale.serial+=1;a.witness(stale);
+        a.advance(1.,true,true,false);assert!(a.busy());a.witness(a.view().unwrap());a.advance(1.,true,true,false);
+        assert!(!a.busy());assert_eq!(a.aura(),6);
+    }
+    #[test]fn each_fresh_press_plays_once_and_held_triangle_never_restarts(){
+        let mut a=Activation::default();a.sync(2,Some(binding()));assert!(a.begin(true,true,2.));
+        for _ in 0..2{a.advance(1.,true,true,false);}a.witness(a.view().unwrap());a.advance(1.,true,true,false);
+        assert_eq!(a.aura(),2);assert!(!a.begin(true,true,2.));a.advance(1.,false,true,false);
+        assert!(a.begin(true,true,2.));assert_eq!(a.aura(),0);assert_eq!(a.view().unwrap().serial,2);
+    }
+    #[test]fn pauses_freeze_and_interruptions_never_grant_an_unplayed_aura(){
+        let mut a=Activation::default();a.sync(9,Some(binding()));assert!(a.begin(true,true,4.));
+        for _ in 0..500{a.advance(1.,true,true,true);}assert_eq!(a.view().unwrap().frame,0.);
+        a.advance(1.,false,false,false);assert!(!a.busy());assert_eq!(a.aura(),0);
+        assert!(a.begin(true,true,1.));for _ in 0..122{a.advance(1.,false,true,false);}assert!(!a.busy());assert_eq!(a.aura(),0);
+    }
+    #[test]fn all_stances_keep_completed_activation_but_owner_selection_changes_rearm(){
+        let mut a=Activation::default();let mut b=binding();a.sync(4,Some(b));assert!(a.begin(true,true,1.));
+        a.advance(1.,false,true,false);a.witness(a.view().unwrap());a.advance(1.,false,true,false);
+        for _ in crate::dual_wield::Style::ALL{b.generation+=1;a.sync(4,Some(b));assert_eq!(a.aura(),4);}
+        a.sync(5,Some(b));assert_eq!(a.aura(),0);assert!(a.begin(true,true,10.));b.generation+=1;a.sync(5,Some(b));assert!(!a.busy());assert_eq!(a.aura(),0);
+        b.instance+=1;a.sync(5,Some(b));assert_eq!(a.aura(),0);a.sync(0,Some(b));assert!(!a.begin(true,true,1.));
+    }
+    #[test]fn centering_cancels_both_authored_hand_tip_offsets_without_editing_particles(){
+        let world=Mat4::from_rotation_y(0.7);let pos=[100.,200.,300.];
+        for offset in [[0.,0.,0.],[28.,6.,-40.]]{let anchor=centered_anchor(world,pos,offset).unwrap();
+            assert!((anchor.transform_point3(Vec3::from(offset))-Vec3::new(100.,130.,300.)).length()<0.001);}
+        assert!(centered_anchor(world,[f32::NAN,0.,0.],[0.;3]).is_none());
+        assert!(!free_slot(0,Some(56)));assert!(!free_slot(21,Some(75)));assert!(free_slot(0,Some(0)));assert!(free_slot(2,Some(10)));
+    }
+}
