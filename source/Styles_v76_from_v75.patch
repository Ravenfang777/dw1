+    write(top+4,read::<u32>(top+4)|0x40);CHOICE.store(0,Ordering::Relaxed);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);assert_eq!(read::<u32>(top+4),0x4a);
+    CHOICE.store(6,Ordering::Relaxed);write(top+0x17,0x34u8);actual::test_context();assert_eq!(read::<u8>(top+0x17),0x34);
+    write(top+0x17,0u8);write(top+0x14,0x20u8);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
+}}
+#[test]fn native_activation_is_once_per_fresh_triangle_and_aura_waits_for_final_pose(){let _lock=TEST.lock().unwrap();unsafe{
+    let h=Host::new();let b=h.base();let top=b+0x529600;actual::test_context();assert!(actual::menu_entry(top,3));assert!(actual::view().is_none());
+    write(b+0x298d4a0+4,crate::overdrive_activation::TRIANGLE);write(b+0x298d4a0+8,crate::overdrive_activation::TRIANGLE);
+    assert!(actual::menu_entry(top,3));let first=actual::view().unwrap();assert_eq!(first.serial,1);assert_eq!(actual::active_choice(),0);
+    actual::menu_entry(top,3);assert_eq!(actual::view().unwrap().serial,1);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
+    write(b+0x298d4a0+8,0u32);for _ in 0..160{actual::frame(h.actor());assert_eq!(actual::active_choice(),0);}
+    actual::frame(h.actor());assert!(actual::busy());actual::witness(actual::view().unwrap());actual::frame(h.actor());assert!(!actual::busy());assert_eq!(actual::active_choice(),6);
+    SLOT.store(56,Ordering::Relaxed);actual::frame(h.actor());assert_eq!(actual::active_choice(),6);SLOT.store(0,Ordering::Relaxed);
+    actual::test_context();write(b+0x298d4a0+8,crate::overdrive_activation::TRIANGLE);actual::menu_entry(top,3);assert!(!actual::busy());
+    write(b+0x298d4a0+4,0u32);actual::frame(h.actor());write(b+0x298d4a0+4,crate::overdrive_activation::TRIANGLE);actual::menu_entry(top,3);assert_eq!(actual::view().unwrap().serial,2);assert_eq!(actual::active_choice(),0);
+}}
+#[test]fn native_prompt_rejects_conflicting_records_shortcuts_and_unavailable_assets(){let _lock=TEST.lock().unwrap();unsafe{
+    let mut h=Host::new();let b=h.base();let top=b+0x529600;h.table[0x87*16]=0x55;actual::test_context();assert_eq!(read::<u8>(top+0x17),0);assert_eq!(h.table[0x87*16],0x55);
+    h.table[0x87*16]=0;SUBMENU.store(true,Ordering::Relaxed);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
+    SUBMENU.store(false,Ordering::Relaxed);write(b+0x298d4a0+4,0x40000u32);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
+    write(b+0x298d4a0+4,0u32);ASSETS.store(false,Ordering::Relaxed);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
+    ASSETS.store(true,Ordering::Relaxed);SLOT.store(56,Ordering::Relaxed);actual::test_context();assert_eq!(read::<u8>(top+0x17),0);
