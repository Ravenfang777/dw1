+struct Host{memory:Vec<u8>,actor:Vec<u8>,instance:Vec<u8>,table:Vec<u8>}
+impl Host{unsafe fn new()->Self{
+    let mut h=Self{memory:vec![0;0x3000000],actor:vec![0;0x800],instance:vec![0;0x200],table:vec![0;256*16]};
+    BASE.store(h.memory.as_mut_ptr()as usize,Ordering::Relaxed);ACTOR.store(h.actor.as_mut_ptr()as usize,Ordering::Relaxed);INSTANCE.store(h.instance.as_mut_ptr()as usize,Ordering::Relaxed);
+    let b=h.base();let a=ACTOR.load(Ordering::Relaxed);write(a+0x374,1u32);write(b+0x23405dc,1f32);
+    let prefix=[0x48u8,0x63,0xc1,0x48,0xc1,0xe0,4,0x48,3,5];std::ptr::copy_nonoverlapping(prefix.as_ptr(),(b+0x28d7d0)as *mut u8,10);
+    write(b+0x28d7d0+10,(0x5000i32-(0x28d7d0i32+14))as i32);write(b+0x5000,h.table.as_mut_ptr()as usize);
