+}fn base(&self)->usize{self.memory.as_ptr()as usize}fn actor(&self)->usize{self.actor.as_ptr()as usize}}
+#[test]fn native_prompt_uses_only_free_fourth_slot_and_restores_only_owned_mask_bits(){let _lock=TEST.lock().unwrap();unsafe{
