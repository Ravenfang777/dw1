+            *b=Some(binding);
+            super::takeover::dual_reset();
+            super::leftblade::clear_pose();
+            REPORTED_READY.store(false,Ordering::Relaxed);
+            log("Dual Wield binding changed: old ground controller/pose/trails retired; current weapon will be re-admitted");
+        }
+    }
+    if let policy::Learn::Added(slot)=policy::learn(&mut list,valid){
+        if rd::<[u8;policy::SLOTS]>(save+0x44)==before{
+            std::ptr::write((save+0x44+slot) as *mut u8,policy::OFF);
+            log("DUAL WIELD LEARNED: one disabled entry added; equip Dual Wield in Sora's Abilities menu; no other ability or AP/stat changed");
+        }else{set_on(false);return;}
+    }
+    let on=valid&&policy::equipped(&list);
+    set_on(on);
+    if on && super::pose::sora_body_seen(1000){
+        super::leftblade::show((weapon!=0).then_some(weapon));
+        if super::leftblade::ready() && super::pose::kh2().is_some_and(|k|k.valor.is_some())
+            && !REPORTED_READY.swap(true,Ordering::Relaxed){
+            log(&format!("DUAL WIELD READY: equipped weapon {weapon:#x} duplicated; Valor base ground combo; native air/casting; offhand_only_test={}",offhand_test()));
+        }
+    }else{super::leftblade::hide();}
+}
+fn set_on(on:bool){
+    if ON.swap(on,Ordering::Relaxed)!=on{
+        super::takeover::dual_reset();
+        super::leftblade::clear_pose();
+        REPORTED_READY.store(false,Ordering::Relaxed);
+        log(if on{"DUAL WIELD EQUIPPED: current weapon duplicated; Valor base ground rows enabled; other abilities unchanged"}
+            else{"DUAL WIELD UNEQUIPPED/SUSPENDED: native moveset restored; duplicate hidden"});
+    }
+    if !on{cancel();}
+}
+pub fn cancel(){OWNED.store(false,Ordering::Relaxed);REQUEST.store(false,Ordering::Relaxed);FRAMES.store(0,Ordering::Relaxed);}
+
+pub unsafe fn request(actor:usize)->bool{
+    if !enabled()||!readable(actor,0x4b0)||actor!=super::takeover::sora_actor()
+        ||rd::<i32>(actor+0x70)!=0||!super::pose::kh2().is_some_and(|k|k.valor.is_some())
+        ||!super::leftblade::ready(){return false;}
+    if !owned()&&!matches!(super::pose::sora_slot(),Some(0..=7)){return false;}
+    REQUEST.store(true,Ordering::Relaxed);true
+}
+pub unsafe fn allow_frame(actor:usize)->bool{
+    if !enabled()||!readable(actor,0x4b0)||rd::<i32>(actor+0x70)!=0
+        ||!super::leftblade::ready()||!super::pose::sora_body_seen(500){cancel();return false;}
+    if !(owned()||pending()){return false;}
+    if FRAMES.fetch_add(1,Ordering::Relaxed)>600{log("Dual Wield: ground ownership timed out; native control restored");cancel();return false;}
+    OWNED.store(true,Ordering::Relaxed);true
+}
+pub fn after_frame(took:bool,attack:bool){
+    REQUEST.store(false,Ordering::Relaxed);
+    if !took||!attack{cancel();}
+}
+pub unsafe fn update_abilities(base:usize,ch:&mut character_core::Character){
+    if let Some(save)=super::menu::save_block(base).filter(|s|readable(*s+0x44,policy::SLOTS)){
+        ch.abilities=policy::abilities(&rd::<[u8;policy::SLOTS]>(save+0x44));
+    }else{ch.abilities=policy::abilities(&[]);}
+}
