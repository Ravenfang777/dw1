+/// Only the standing idle is replaced. KH1 still owns locomotion, casting, reactions,
+/// menus and scripts; the idle's two weapons and body use the same game-frame clock.
+fn dual_idle_pose(s: &mut Sora, to_world: &Mat4) -> Option<Vec<Mat4>> {
+    let form = kh2()?.valor.as_ref()?;
+    let rig = &form.rig;
+    let motion = character_core::motion::IDLE;
+    let clip = rig.motions.get(&motion)?;
+    let frame = super::takeover::GAME_FRAME.load(Ordering::Relaxed);
+    let start = *s.dual_idle_at.get_or_insert(frame);
+    let frames = frame.saturating_sub(start) as f32;
+    let body = kh2_anim::evaluate(&rig.skeleton, clip,
+        kh2_anim::key_time(clip, frames, true), kh2_anim::Options::default()).bones;
+    let weapon = |index: usize| -> Option<Vec<Mat4>> {
+        let w = rig.weapons.get(index)?;
+        let hand = *body.get(w.bone?)?;
+        let local = match w.motions.get(&motion) {
+            Some(m) => kh2_anim::evaluate(&w.skeleton, m,
+                kh2_anim::key_time(m, frames, true), kh2_anim::Options::default()).bones,
+            None => kh2_anim::Pose::bind(&w.skeleton).bones,
+        };
+        Some(local.iter().map(|m| hand * *m).collect())
+    };
+    let right = weapon(0)?;
+    let left = weapon(1)?;
+    super::leftblade::note_idle_left(&left, &body);
+    let out = s.retarget.as_ref()?.pose_grip(&body, true);
+    note_kh2(&body, to_world);
+    s.kh2_now=Some((body,right));
+    s.src_now=src::FOLLOW;
+    Some(out)
+}
