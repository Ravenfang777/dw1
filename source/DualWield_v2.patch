+//! Policy for the isolated Dual Wield prototype. No Drive state or ability rewards.
+use character_core::{Abilities, ComboRow};
+
+pub const ID: u8 = 126;
+pub const OFF: u8 = ID | 0x80;
+pub const AP: u8 = 0;
+pub const NAME: &str = "Dual Wield";
+pub const HELP: &str = "Wield a copy of your equipped weapon. Uses a two-Keyblade ground combo.";
+pub const SLOTS: usize = 48;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Learn { Present, Added(usize), Full, NotLoaded }
+
+/// Append only our disabled entry. Never evict, switch, reorder or grant another ability.
+pub fn learn(list: &mut [u8; SLOTS], loaded: bool) -> Learn {
+    if !loaded { return Learn::NotLoaded; }
+    let end = list.iter().position(|b| *b == 0).unwrap_or(SLOTS);
+    if list[..end].iter().any(|b| b & 0x7f == ID) { return Learn::Present; }
+    if end >= SLOTS - 1 || list[end..].iter().any(|b|*b!=0) { return Learn::Full; }
+    list[end] = OFF;
+    Learn::Added(end)
+}
+
+pub fn equipped(list: &[u8]) -> bool {
+    list.iter().take_while(|b| **b != 0).any(|b| *b == ID)
+}
+
+/// Only Dual Wield is removed by the explicit uninstall option.
+pub fn remove(list: &mut [u8; SLOTS]) -> bool {
+    let mut out = *list;
+    let end=list.iter().position(|b|*b==0).unwrap_or(SLOTS);
+    out[..end].fill(0);
+    let mut n = 0;
+    for &b in list.iter().take_while(|b| **b != 0) {
+        if b & 0x7f != ID { out[n] = b; n += 1; }
+    }
+    for i in end..SLOTS{if out[i]&0x7f==ID{out[i]=0;}}
+    let changed = *list != out;
+    if changed { *list = out; }
+    changed
+}
+
+/// Native entries are copied verbatim. Only the new record and unused padding differ.
+pub fn ability_table(native:&[u8],name:u32,help:u32)->Option<Vec<u8>>{
+    if native.len()!=65*12 || name==0 || help==0{return None;}
+    let mut out=vec![0;127*12];
+    out[..native.len()].copy_from_slice(native);
+    let at=(ID as usize-1)*12;
+    out[at..at+12].copy_from_slice(&native[64*12..65*12]);
+    out[at]=AP;
+    let order=u16::from_le_bytes(native[64*12+2..64*12+4].try_into().ok()?).saturating_add(1);
+    out[at+2..at+4].copy_from_slice(&order.to_le_bytes());
+    out[at+4..at+8].copy_from_slice(&name.to_le_bytes());
+    out[at+8..at+12].copy_from_slice(&help.to_le_bytes());
+    Some(out)
+}
+
+/// Only existing KH1 combo modifiers carry into the imported base combo.
+/// No growth, guard, recovery, finisher or action ability is granted internally.
+pub fn abilities(list: &[u8]) -> Abilities {
+    let count = |id| list.iter().take_while(|b| **b != 0).filter(|b| **b == id).count().min(255) as u8;
+    Abilities { guard: false, combo_plus: count(6), air_combo_plus: count(7),
+        combo_master: count(65) != 0, one_swing_on_miss: count(65) == 0,
+        ..Abilities::default() }
+}
+
+/// Base ground rows only. Added abilities and jump/air rows are not made available.
+pub fn retain_ground(rows: &mut Vec<ComboRow>) {
+    rows.retain(|r| r.ability == 0 && !r.is_air() && !r.is_jump());
+    let ids: Vec<_> = rows.iter().map(|r| r.id).collect();
+    for r in rows {
+        if r.sub >= 0 && !ids.contains(&(r.sub as u8)) { r.sub = -1; }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn adds_only_dual_disabled_in_one_empty_slot() {
+        let mut a = [0; SLOTS]; a[..4].copy_from_slice(&[21, 0x96, 6, 65]);
+        let before = a;
+        assert_eq!(learn(&mut a, true), Learn::Added(4));
+        assert_eq!(a[4], OFF); assert!(!equipped(&a));
+        assert_eq!((0..SLOTS).filter(|&i| a[i] != before[i]).collect::<Vec<_>>(), vec![4]);
+        assert_eq!(learn(&mut a, true), Learn::Present);
+    }
+    #[test] fn only_exact_equipped_byte_enables() {
+        assert!(!equipped(&[OFF, 0])); assert!(equipped(&[21, ID, 0]));
+        assert!(!equipped(&[21, 0, ID])); assert!(!equipped(&[66, 0]));
+    }
+    #[test] fn full_list_keeps_all_existing_abilities() {
+        let mut a = [21; SLOTS]; let before = a;
+        assert_eq!(learn(&mut a, true), Learn::Full); assert_eq!(a, before);
+        a[SLOTS-1]=0; let before=a;
+        assert_eq!(learn(&mut a, true), Learn::Full); assert_eq!(a,before);
+    }
+    #[test] fn unloaded_state_never_changes_list() {
+        let mut a=[0;SLOTS]; let before=a;
+        assert_eq!(learn(&mut a,false),Learn::NotLoaded);assert_eq!(a,before);
+    }
+    #[test] fn fragmented_lists_are_not_repaired_or_activated(){
+        let mut a=[0;SLOTS];a[0]=21;a[5]=6;let before=a;
+        assert_eq!(learn(&mut a,true),Learn::Full);assert_eq!(a,before);
+        a[1]=OFF;a[2]=0;assert!(remove(&mut a));assert_eq!(a[5],6);assert_eq!(&a[..2],&[21,0]);
+    }
+    #[test] fn native_table_records_are_exact_and_only_dual_record_added(){
+        let native:Vec<u8>=(0..65*12).map(|i|(i%251)as u8).collect();
+        let out=ability_table(&native,0x81001000,0x81002000).unwrap();
+        assert_eq!(&out[..65*12],native.as_slice());
+        let at=(ID as usize-1)*12;assert!(out[65*12..at].iter().all(|b|*b==0));
+        assert_eq!(out[at],0);assert_eq!(out[at+1],native[64*12+1]);
+        assert_eq!(&out[at+4..at+8],&0x81001000u32.to_le_bytes());
+        assert_eq!(&out[at+8..at+12],&0x81002000u32.to_le_bytes());
+        assert!(out[at+12..].iter().all(|b|*b==0));
+        assert!(ability_table(&native[..700],1,1).is_none());
+        assert!(ability_table(&native,0,1).is_none());
+    }
+    #[test] fn removal_preserves_other_states_order_and_duplicates() {
+        let mut a=[0;SLOTS]; a[..6].copy_from_slice(&[21,OFF,6,0x96,ID,6]);
+        assert!(remove(&mut a));assert_eq!(&a[..5], &[21,6,0x96,6,0]);
+        assert!(!remove(&mut a));
+    }
+    #[test] fn no_growth_or_action_abilities_added() {
+        let a=abilities(&[ID,6,6,0x86,7,65,0]);
+        assert_eq!(a.combo_plus,2); assert_eq!(a.air_combo_plus,1); assert!(a.combo_master);
+        assert!(!a.guard && !a.aerial_recovery && a.equipped.is_empty());
+        assert_eq!((a.high_jump,a.quick_run,a.aerial_dodge,a.glide,a.dodge_roll),(0,0,0,0,0));
+        assert_eq!((a.finishing_plus,a.negative_combo),(0,0));
+    }
+    fn row(id:u8,motion:u16)->ComboRow{
+        ComboRow{id,kind:3,sub:-1,combo_offset:0,flag:0,motion,next_motion:0,jump:0.0,jump_min:0.0,jump_max:0.0,
+            speed_min:0.0,speed_max:0.0,near:0.0,far:1000.0,low:-1000.0,high:1000.0,inner_min:-1.0,inner_max:1.0,
+            blend_time:0.0,distance_adjust:0.0,ability:0,score:0}
+    }
+    #[test] fn ground_filter_preserves_order_and_rejects_added_ability_air_and_hop_rows(){
+        let basic=row(1,151);let mut air=row(2,152);air.flag=character_core::FLAG_AIR;
+        let mut added=row(3,153);added.ability=95;
+        let mut hop=row(4,154);hop.jump=10.0;
+        let mut finish=row(5,155);finish.flag=character_core::FLAG_FINISHER;finish.sub=3;
+        let mut rows=vec![basic.clone(),air,added,hop,finish];retain_ground(&mut rows);
+        assert_eq!(rows.iter().map(|r|r.id).collect::<Vec<_>>(),vec![1,5]);
+        assert_eq!(rows[0],basic);assert_eq!(rows[1].sub,-1);assert!(rows[1].is_finisher());
+    }
+    #[test] fn imported_clip_keeps_both_weapons_own_contact_windows(){
+        use character_core::{Clip,Window,WindowKind,Character,Moveset,MoveParams,AttackParams,Input,Button,Env};
+        let mut clip=Clip::plain(151,12);
+        clip.windows=vec![
+            Window{start:2,end:Some(4),kind:WindowKind::Hitbox{attack:10,group:1,combo:None,weapon:1}},
+            Window{start:5,end:Some(7),kind:WindowKind::Hitbox{attack:11,group:2,combo:None,weapon:2}},
+        ];
+        let mut moveset=Moveset::default();moveset.clips.insert(151,clip.clone());moveset.combo_rows.push(row(1,151));
+        retain_ground(&mut moveset.combo_rows);
+        let mut ch=Character::new(moveset,MoveParams::default(),vec![],AttackParams::default());
+        ch.abilities=abilities(&[ID,0]);
+        let env=Env{pos:[0.0;3],grounded:true,height_above_ground:0.0,targets:&[],ledges:&[]};
+        let mut seen=std::collections::BTreeSet::new();
+        for tick in 0..12{
+            let input=Input{attack:Button{pressed:tick==0,held:tick==0},..Input::default()};
+            let out=ch.step(&input,&env);
+            for h in out.hitboxes{
+                assert!(clip.windows.iter().any(|w|w.contains(out.clip_frame)&&matches!(w.kind,WindowKind::Hitbox{weapon,..}if weapon==h.weapon)));
+                seen.insert(h.weapon);
+            }
+        }
+        assert_eq!(seen.into_iter().collect::<Vec<_>>(),vec![1,2]);
+        assert!(!ch.abilities.guard && ch.abilities.equipped.is_empty());
+    }
+}
