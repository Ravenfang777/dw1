+//! Sample accepted native/KH2 ground combos once per physics frame; no input or actor writes.
+use super::{addr::Rva,dual,pose,single_f,takeover};
+use crate::{dual_wield::Binding,sound_preview::Trigger};
+use std::sync::{Mutex,OnceLock};
+#[derive(Default)]struct Runtime{trigger:Trigger,scope:Option<Binding>,choice:u32,suspended:bool}
+static STATE:OnceLock<Mutex<Runtime>>=OnceLock::new();
+unsafe fn rd<T:Copy>(p:usize)->T{std::ptr::read_unaligned(p as *const T)}
+pub unsafe fn frame(actor:usize){
+    if actor!=takeover::sora_actor(){return;}
+    let base=super::sys::GetModuleHandleA(std::ptr::null())as usize;
+    let selected=single_f::sound_preview_choice();
+    let scope=dual::binding().filter(|b|b.actor==actor&&super::crash::readable(actor+0x447)
+        &&rd::<u32>(actor+0x374)&3==1&&rd::<u32>(base+Rva(0x298d3a0))==0
+        &&pose::ptr(rd::<u32>(actor+0x440))==0&&rd::<u32>(actor+0x444)&1==0&&!dual::removing());
+    let paused=takeover::paused()||super::kh2fx::pause_menu_up(base)||super::overdrive_activation::busy();
+    let ground=if dual::owned(){
+        !dual::guard_session()&&!dual::roll_session()&&!dual::aerial_session()&&takeover::with_kh2(|c,o|
+            o.state==character_core::StateName::Attack&&!c.airborne()&&!matches!(o.motion,41|42)).unwrap_or(false)
+    }else{
+        let request=rd::<u32>(actor+0x164);
+        scope.is_some_and(|b|!dual::pending()&&crate::sound_preview::native_ground(rd(actor+0x70),request,pose::native_request_current(b.instance,request)))
+    };
+    let Ok(mut s)=STATE.get_or_init(||Mutex::new(Runtime::default())).try_lock()else{return;};
+    if s.scope!=scope||s.choice!=selected||paused&&!s.suspended{super::kh2sound::stop_preview();}
+    s.scope=scope;s.choice=selected;s.suspended=paused;
+    let frame=takeover::GAME_FRAME.load(std::sync::atomic::Ordering::Relaxed);
+    if s.trigger.step(scope,selected,frame,ground,paused,rd(base+Rva(0x23405dc))){super::kh2sound::preview(selected);}
+}
+#[cfg(test)]pub(super) fn test_reset(){*STATE.get_or_init(||Mutex::new(Runtime::default())).lock().unwrap()=Runtime::default();}
